<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>qbagent</ToolCommandName>
    <PackageId>SharpNinja.McpServer.QBAgent</PackageId>
    <Authors>SharpNinja</Authors>
    <Description>QBAgent command-line agent backed by MCP Server QuadBrain and workspace-scoped tool execution.</Description>
    <PackageTags>mcp;quadbrain;qbagent;model-context-protocol;agent;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SharpNinja/McpServer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SharpNinja/McpServer</PackageProjectUrl>
    <RootNamespace>McpServer.QBAgent</RootNamespace>
    <AssemblyName>McpServer.QBAgent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpServer.McpAgent\McpServer.McpAgent.csproj" />
    <ProjectReference Include="..\McpServer.QBAgent.Tools\McpServer.QBAgent.Tools.csproj" />
  </ItemGroup>
</Project>
