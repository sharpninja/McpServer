@page "/context/search"

@inject IContextApiClient ContextApiClient

<PageTitle>Context Search</PageTitle>

<h1 class="h2 mb-3">Context Search</h1>

<form method="get" class="Box p-3 mb-3">
    <div class="d-flex flex-column gap-2">
        <label class="d-flex flex-column">
            <span class="text-small color-fg-muted">Query</span>
            <input class="form-control" name="q" value="@Q" />
        </label>
        <div class="d-flex flex-wrap gap-3">
            <label class="d-flex flex-column">
                <span class="text-small color-fg-muted">Source Type</span>
                <select class="form-select" name="sourceType">
                    <option value="" selected="@string.IsNullOrWhiteSpace(SourceType)">All</option>
                    @foreach (var sourceTypeOption in _sourceTypes)
                    {
                        <option value="@sourceTypeOption" selected="@string.Equals(SourceType, sourceTypeOption, StringComparison.OrdinalIgnoreCase)">
                            @sourceTypeOption
                        </option>
                    }
                </select>
            </label>
            <label class="d-flex flex-column">
                <span class="text-small color-fg-muted">Limit</span>
                <input class="form-control" name="limit" value="@GetLimitValue()" />
            </label>
        </div>
        <div>
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <PrimerFlash Variant="danger" Title="Context search failed">@_error</PrimerFlash>
}
else if (_loading)
{
    <p class="color-fg-muted">Running search...</p>
}
else if (string.IsNullOrWhiteSpace(Q))
{
    <PrimerBlankslate Heading="Enter a search query" Description="Submit a query to search indexed context chunks." />
}
else if (_result is null || _result.Chunks.Count == 0)
{
    <PrimerBlankslate Heading="No context results" Description="No chunks matched the search criteria." />
}
else
{
    <p class="color-fg-muted">Found @_result.Chunks.Count chunks.</p>
    <PrimerDataTable TItem="ContextChunkView" Items="_result.Chunks" ColumnCount="4" Class="Table--full-width">
        <HeaderTemplate>
            <tr>
                <th>Document</th>
                <th>Chunk</th>
                <th>Score</th>
                <th>Content</th>
            </tr>
        </HeaderTemplate>
        <RowTemplate Context="chunk">
            <td><code>@chunk.DocumentId</code></td>
            <td>@chunk.ChunkIndex</td>
            <td>@chunk.Score.ToString("0.000")</td>
            <td>@GetExcerpt(chunk.Content)</td>
        </RowTemplate>
    </PrimerDataTable>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery]
    public string? SourceType { get; set; }

    [SupplyParameterFromQuery]
    public int? Limit { get; set; }

    private ContextSearchPayload? _result;
    private IReadOnlyList<string> _sourceTypes = [];
    private bool _loading;
    private string? _error;
    private string? _lastQueryKey;

    protected override async Task OnParametersSetAsync()
    {
        var queryKey = $"{Q}|{SourceType}|{Limit}";
        if (string.Equals(queryKey, _lastQueryKey, StringComparison.Ordinal))
            return;

        _lastQueryKey = queryKey;
        _loading = true;
        _error = null;

        try
        {
            var sourcePayload = await ContextApiClient.ListSourcesAsync().ConfigureAwait(false);
            _sourceTypes = sourcePayload.Sources
                .Select(static source => source.SourceType)
                .Where(static sourceType => !string.IsNullOrWhiteSpace(sourceType))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static sourceType => sourceType)
                .ToList();

            if (string.IsNullOrWhiteSpace(Q))
            {
                _result = null;
                return;
            }

            var safeLimit = Limit.GetValueOrDefault(20);
            if (safeLimit <= 0)
                safeLimit = 20;

            _result = await ContextApiClient.SearchAsync(new SearchContextQuery
            {
                Query = Q,
                SourceType = string.IsNullOrWhiteSpace(SourceType) ? null : SourceType,
                Limit = safeLimit,
            }).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _result = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetLimitValue() => Limit?.ToString() ?? "20";

    private static string GetExcerpt(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        const int maxLength = 220;
        return content.Length <= maxLength ? content : $"{content[..maxLength]}...";
    }
}

