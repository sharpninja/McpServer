@page "/health-dashboard"

@inject IHealthApiClient HealthApiClient

<PageTitle>Health Dashboard</PageTitle>

<h1 class="h2 mb-3">Health Dashboard</h1>

<p>
    <a class="btn btn-sm" href="@GetRefreshHref()">Refresh</a>
</p>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <PrimerFlash Variant="danger" Title="Failed to load health snapshot">@_error</PrimerFlash>
}
else if (_loading)
{
    <p class="color-fg-muted">Loading health status...</p>
}
else if (_snapshot is null)
{
    <PrimerBlankslate Heading="No health data" Description="Health check did not return data." />
}
else
{
    <div class="Box mb-3">
        <div class="Box-header">
            <h2 class="h3 mb-0">Current Status</h2>
        </div>
        <div class="Box-body">
            <p><strong>Checked At:</strong> @_snapshot.CheckedAt.ToString("u")</p>
            <p><strong>Base URL:</strong> @(_snapshot.ServerBaseUrl ?? "(not set)")</p>
            <p>
                <strong>Status:</strong>
                <PrimerLabel Scheme="@GetHealthScheme(_snapshot.Status)" Text="@_snapshot.Status" />
            </p>
        </div>
    </div>

    <div class="Box">
        <div class="Box-header">
            <h3 class="h4 mb-0">Raw Payload</h3>
        </div>
        <div class="Box-body">
            <pre class="mb-0">@_snapshot.RawPayload</pre>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "refresh")]
    public string? RefreshToken { get; set; }

    private HealthSnapshot? _snapshot;
    private bool _loading;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _snapshot = null;

        try
        {
            _snapshot = await HealthApiClient.CheckHealthAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetHealthScheme(string status)
        => string.Equals(status, "healthy", StringComparison.OrdinalIgnoreCase) ? "success" : "attention";

    private static string GetRefreshHref()
        => $"/health-dashboard?refresh={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
}

