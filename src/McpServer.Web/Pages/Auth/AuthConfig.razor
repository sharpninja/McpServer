@page "/auth/config"

@inject IAuthConfigApiClient AuthConfigApiClient

<PageTitle>Auth Config</PageTitle>

<h1 class="h2 mb-3">Auth Config</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <PrimerFlash Variant="danger" Title="Failed to load auth configuration">@_error</PrimerFlash>
}
else if (_loading)
{
    <p class="color-fg-muted">Loading auth configuration...</p>
}
else if (_snapshot is null)
{
    <PrimerBlankslate Heading="No auth configuration available" Description="The server did not return auth configuration data." />
}
else
{
    <div class="Box">
        <div class="Box-header">
            <h2 class="h3 mb-0">Authentication Settings</h2>
        </div>
        <div class="Box-body">
            <p><strong>Retrieved At:</strong> @_snapshot.RetrievedAt.ToString("u")</p>
            <p><strong>Enabled:</strong> @(_snapshot.Enabled ? "Yes" : "No")</p>
            <p><strong>Authority:</strong> @(_snapshot.Authority ?? "(not set)")</p>
            <p><strong>Client ID:</strong> @(_snapshot.ClientId ?? "(not set)")</p>
            <p><strong>Scopes:</strong> @(_snapshot.Scopes ?? "(not set)")</p>
            <p><strong>Device Authorization Endpoint:</strong> @(_snapshot.DeviceAuthorizationEndpoint ?? "(not set)")</p>
            <p><strong>Token Endpoint:</strong> @(_snapshot.TokenEndpoint ?? "(not set)")</p>
        </div>
    </div>
}

@code {
    private AuthConfigSnapshot? _snapshot;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot = await AuthConfigApiClient.GetAuthConfigAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}

