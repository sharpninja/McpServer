@page "/todos/{TodoId}"
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject TodoDetailViewModel ViewModel
@inject TodoListViewModel ListViewModel
@inject IAuthorizationPolicyService AuthPolicy

<PageTitle>Todo Detail</PageTitle>

<div class="detail-layout">
    <aside class="detail-sidebar">
        <div class="sidebar-header">Todos</div>
        @foreach (var item in ListViewModel?.Items ?? [])
        {
            <a class="sidebar-item @(string.Equals(item.Id, TodoId, StringComparison.Ordinal) ? "active" : "")"
               href="@GetDetailHref(item.Id)">
                <span class="color-fg-muted f6">@item.Id</span>
                <br />@item.Title
            </a>
        }
    </aside>

    <div class="detail-main">
        @if (string.IsNullOrWhiteSpace(TodoId))
        {
            <PrimerBlankslate Heading="No todo selected" Description="Choose a TODO from the sidebar." />
        }
        else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <PrimerFlash Variant="danger" Title="Failed to load todo">@ViewModel.ErrorMessage</PrimerFlash>
        }
        else if (ViewModel.IsBusy)
        {
            <p class="color-fg-muted">Loading todo details...</p>
        }
        else if (ViewModel.Detail is null)
        {
            <PrimerBlankslate Heading="Todo not found" Description="The requested TODO item could not be found." />
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(ViewModel.MutationMessage))
            {
                <PrimerFlash Variant="success" Title="Success">@ViewModel.MutationMessage</PrimerFlash>
            }

            <div class="Box mb-3">
                <div class="Box-header d-flex flex-justify-between flex-items-center">
                    <h2 class="h3 mb-0">@ViewModel.Detail.Id — @ViewModel.Detail.Title</h2>
                    @if (CanEdit)
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@ViewModel.IsBusy">
                                <OcticonIcon Name="check-circle" Size="16" /> Save
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="DeleteAsync" disabled="@ViewModel.IsBusy">
                                <OcticonIcon Name="trash" Size="16" /> Delete
                            </button>
                        </div>
                    }
                </div>
                <div class="Box-body p-0">
                    <MonacoEditor @bind-Value="ViewModel.EditorMarkdownText"
                                  Language="markdown"
                                  ReadOnly="@(!CanEdit)"
                                  Height="600" />
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string TodoId { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string? Section { get; set; }

    [SupplyParameterFromQuery]
    public string? Priority { get; set; }

    [SupplyParameterFromQuery]
    public bool? Done { get; set; }

    private string? _loadedId;
    private string? _lastFilterKey;
    private bool CanEdit => AuthPolicy.CanExecuteAction(McpServer.UI.Core.Authorization.McpActionKeys.TodoUpdate);

    protected override async Task OnParametersSetAsync()
    {
        var filterKey = $"{Section}|{Priority}|{Done}";
        if (!string.Equals(filterKey, _lastFilterKey, StringComparison.Ordinal))
        {
            _lastFilterKey = filterKey;
            ListViewModel.Section = Section;
            ListViewModel.Priority = Priority;
            ListViewModel.Done = Done;
            await ListViewModel.LoadAsync().ConfigureAwait(false);
        }

        if (string.Equals(_loadedId, TodoId, StringComparison.Ordinal))
            return;

        _loadedId = TodoId;
        ViewModel.TodoId = TodoId;
        await ViewModel.LoadAsync().ConfigureAwait(false);
    }

    private async Task SaveAsync()
    {
        ViewModel.ApplyMarkdownToEditor();
        await ViewModel.SaveAsync().ConfigureAwait(false);
    }

    private async Task DeleteAsync() => await ViewModel.DeleteAsync().ConfigureAwait(false);

    private string GetDetailHref(string id)
    {
        var qs = BuildFilterQueryString();
        return string.IsNullOrEmpty(qs)
            ? $"/todos/{Uri.EscapeDataString(id)}"
            : $"/todos/{Uri.EscapeDataString(id)}?{qs}";
    }

    private string BuildFilterQueryString()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Section)) parts.Add($"section={Uri.EscapeDataString(Section)}");
        if (!string.IsNullOrWhiteSpace(Priority)) parts.Add($"priority={Uri.EscapeDataString(Priority)}");
        if (Done.HasValue) parts.Add($"done={Done.Value.ToString().ToLowerInvariant()}");
        return string.Join("&", parts);
    }
}

