<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpServer.Web</RootNamespace>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <NoWarn>$(NoWarn);CA1515;CA1849;CA1031</NoWarn>
  </PropertyGroup>

  <!-- NOTE: wwwroot static assets for tool packaging are injected post-pack
       by Update-DotnetTool.ps1 since the dotnet tool pack pipeline ignores
       TfmSpecificPackageFile items for extra content directories. -->

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" />
    <ProjectReference Include="..\McpServer.Client\McpServer.Client.csproj" />
    <ProjectReference Include="..\McpServer.UI.Core\McpServer.UI.Core.csproj" />
    <ProjectReference Include="..\McpServer.Cqrs\McpServer.Cqrs.csproj" />
  </ItemGroup>
</Project>
