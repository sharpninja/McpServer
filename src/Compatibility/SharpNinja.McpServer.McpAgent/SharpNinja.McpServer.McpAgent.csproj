<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>SharpNinja.McpServer.McpAgent</PackageId>
    <Authors>SharpNinja</Authors>
    <Description>1.x compatibility package for QBrainAI.McpAgent. Public types moved to namespace QBrainAi.McpAgent. Removed at 2.0.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SharpNinja/McpServer</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>QBrainAi.McpAgent</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\QBrainAi.McpAgent\QBrainAi.McpAgent.csproj">
      <PrivateAssets>none</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <!-- TR-MCP-QBRAIN-003: dependency facade. Namespace-preserving type forwards are impossible once the root token changes. -->
</Project>
