<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>qbagent</ToolCommandName>
    <PackageId>SharpNinja.McpServer.QBAgent</PackageId>
    <Authors>SharpNinja</Authors>
    <Description>1.x package id for the qbagent tool. The command name stays qbagent. Canonical package id is QBrainAI.QBAgent.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SharpNinja/McpServer</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>QBrainAi.QBAgent</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\QBrainAi.QBAgent\**\*.cs" Exclude="..\..\QBrainAi.QBAgent\obj\**\*.cs;..\..\QBrainAi.QBAgent\bin\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\QBrainAi.McpAgent\QBrainAi.McpAgent.csproj" />
    <ProjectReference Include="..\..\QBrainAi.QBAgent.Tools\QBrainAi.QBAgent.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>QBrainAi.QBAgent.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
