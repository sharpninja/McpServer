  "inputSchema": {
    "type": "object",
    "properties": {
      "agent": {
        "description": "Agent source type",
        "type": "string"
      },
      "sessionId": {
        "description": "Session id",
        "type": "string"
      },
      "requestId": {
        "description": "Request id",
        "type": "string"
      },
      "section": {
        "description": "Section name",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      }
    },
    "required": [
      "agent",
      "sessionId",
      "requestId",
      "section",
      "workspacePath"
    ]
  }
}