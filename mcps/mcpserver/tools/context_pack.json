{
  "name": "context_pack",
  "description": "Get a deterministic context pack by query. Optional queryId and limit (1-100).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "description": "Search query text",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "limit": {
        "description": "Max chunks in pack (default 20)",
        "type": "integer",
        "default": 20
      },
      "queryId": {
        "description": "Optional query id for reproducibility",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "query",
      "workspacePath"
    ]
  }
}