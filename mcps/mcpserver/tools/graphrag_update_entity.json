{
  "name": "graphrag_update_entity",
  "description": "Update an existing graph entity by ID.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "entityId": {
        "description": "Entity ID to update",
        "type": "string"
      },
      "name": {
        "description": "Updated entity name",
        "type": "string"
      },
      "entityType": {
        "description": "Updated entity type",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "description": {
        "description": "Updated description",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "metadata": {
        "description": "Updated JSON metadata",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "entityId",
      "name",
      "entityType",
      "workspacePath"
    ]
  }
}