{
  "name": "brain_slot_invoke",
  "description": "Invoke an external brain slot with transaction-gated output return.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "slotId": {
        "description": "Slot id",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "input": {
        "description": "Input prompt",
        "type": "string"
      },
      "turnId": {
        "description": "Owning session-log turn id",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "admitToGraphRag": {
        "description": "Whether committed Curiosity output should be admitted to GraphRAG/context",
        "type": "boolean",
        "default": false
      },
      "metadataJson": {
        "description": "Optional JSON object of string metadata",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "slotId",
      "workspacePath",
      "input"
    ]
  }
}