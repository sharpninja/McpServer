{
  "name": "sessionlog_dialog",
  "description": "Append processing dialog items to a session log entry.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "agent": {
        "description": "Agent source type",
        "type": "string"
      },
      "sessionId": {
        "description": "Session id",
        "type": "string"
      },
      "requestId": {
        "description": "Request id",
        "type": "string"
      },
      "itemsJson": {
        "description": "JSON array of dialog items",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      }
    },
    "required": [
      "agent",
      "sessionId",
      "requestId",
      "itemsJson",
      "workspacePath"
    ]
  }
}