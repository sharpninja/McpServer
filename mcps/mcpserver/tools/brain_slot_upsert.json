{
  "name": "brain_slot_upsert",
  "description": "Create or update an external brain-slot definition.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "slotId": {
        "description": "Slot id",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "role": {
        "description": "Role: LeftHemisphere, RightHemisphere, CuriosityEngine, or ArbiterOfTruth",
        "type": "string"
      },
      "providerKind": {
        "description": "Provider kind: OpenAI or OpenAICompatible",
        "type": "string"
      },
      "modelId": {
        "description": "Model id",
        "type": "string"
      },
      "credentialReference": {
        "description": "Credential reference using env:, config:, or file:",
        "type": "string"
      },
      "partyId": {
        "description": "Trusted party id; defaults to brain-slot role mapping when omitted",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "displayName": {
        "description": "Optional display name",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "endpoint": {
        "description": "Optional endpoint URI",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "enabled": {
        "description": "Whether the slot is enabled",
        "type": "boolean",
        "default": false
      },
      "replaceExisting": {
        "description": "Allow replacement of an existing enabled slot for the same role",
        "type": "boolean",
        "default": false
      },
      "timeoutSeconds": {
        "description": "Timeout in seconds",
        "type": "integer",
        "default": 30
      },
      "maxOutputTokens": {
        "description": "Maximum output tokens",
        "type": "integer",
        "default": 1024
      },
      "systemPrompt": {
        "description": "Optional system prompt",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "slotId",
      "workspacePath",
      "role",
      "providerKind",
      "modelId",
      "credentialReference"
    ]
  }
}