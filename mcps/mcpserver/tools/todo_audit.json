{
  "name": "todo_audit",
  "description": "Get append-only audit history for a TODO item by id.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "description": "TODO item id",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "limit": {
        "description": "Maximum entries to return (default 50)",
        "type": "integer",
        "default": 50
      },
      "offset": {
        "description": "Entries to skip before returning results (default 0)",
        "type": "integer",
        "default": 0
      }
    },
    "required": [
      "id",
      "workspacePath"
    ]
  }
}