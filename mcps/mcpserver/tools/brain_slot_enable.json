{
  "name": "brain_slot_enable",
  "description": "Enable an external brain-slot definition.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "slotId": {
        "description": "Slot id",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "replaceExisting": {
        "description": "Allow replacement of an existing enabled slot for the same role",
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "slotId",
      "workspacePath"
    ]
  }
}