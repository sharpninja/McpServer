{
  "name": "graphrag_list_relationships",
  "description": "List graph relationships with pagination and optional entity/type filters.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "skip": {
        "description": "Number of relationships to skip (default 0)",
        "type": "integer",
        "default": 0
      },
      "take": {
        "description": "Maximum relationships to return (default 50)",
        "type": "integer",
        "default": 50
      },
      "entityId": {
        "description": "Optional entity ID filter",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "relationshipType": {
        "description": "Optional relationship type filter",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "workspacePath"
    ]
  }
}