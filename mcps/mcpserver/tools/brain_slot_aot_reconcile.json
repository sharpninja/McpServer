      },
      "input": {
        "description": "Original input prompt",
        "type": "string"
      },
      "creativityOutput": {
        "description": "Committed Creativity output",
        "type": "string"
      },
      "logicOutput": {
        "description": "Committed Logic output",
        "type": "string"
      },
      "curiosityOutput": {
        "description": "Committed CuriosityEngine output",
        "type": "string"
      },
      "turnId": {
        "description": "Owning session-log turn id",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "metadataJson": {
        "description": "Optional JSON object of string metadata",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
