{
  "name": "sessionlog_fail_turn",
  "description": "Fail a session turn, recording the failure note. Merges turnJson additively; subject to the same compliance gate as complete.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "agent": {
        "description": "Agent source type",
        "type": "string"
      },
      "sessionId": {
        "description": "Session id",
        "type": "string"
      },
      "requestId": {
        "description": "Request id",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "turnJson": {
        "description": "Optional JSON turn payload (UnifiedRequestEntryDto) merged additively",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "agent",
      "sessionId",
      "requestId",
      "workspacePath"
    ]
  }
}