{
  "name": "todo_move",
  "description": "Move a TODO item from one workspace to another by its ID.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "description": "TODO item id",
        "type": "string"
      },
      "workspacePath": {
        "description": "Source workspace path (required)",
        "type": "string"
      },
      "targetWorkspacePath": {
        "description": "Target workspace path to move the item to",
        "type": "string"
      }
    },
    "required": [
      "id",
      "workspacePath",
      "targetWorkspacePath"
    ]
  }
}