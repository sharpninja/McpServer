{
  "name": "memory_promote",
  "description": "Promote a session-log or context source into memory when the operator explicitly wants that text remembered. Do not auto-promote completed turns.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "sourceKind": {
        "description": "Source kind: sessionlog or context",
        "type": "string"
      },
      "sourceRef": {
        "description": "Source reference",
        "type": "string"
      },
      "content": {
        "description": "Optional content override",
        "type": ["string", "null"],
        "default": null
      },
      "summary": {
        "description": "Optional summary override",
        "type": ["string", "null"],
        "default": null
      }
    },
    "required": [
      "workspacePath",
      "sourceKind",
      "sourceRef"
    ]
  }
}
