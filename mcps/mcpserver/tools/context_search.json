{
  "name": "context_search",
  "description": "Search indexed context chunks by query text. Optional sourceType filter and limit (1-100).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "description": "Search query text",
        "type": "string"
      },
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "limit": {
        "description": "Max chunks to return (default 20)",
        "type": "integer",
        "default": 20
      },
      "sourceType": {
        "description": "Optional source type filter",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "query",
      "workspacePath"
    ]
  }
}