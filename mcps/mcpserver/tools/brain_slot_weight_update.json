{
  "name": "brain_slot_weight_update",
  "description": "Apply an approved durable Quad-Brain role-weight update.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspacePath": {
        "description": "Workspace path (required)",
        "type": "string"
      },
      "roleWeightsJson": {
        "description": "JSON object mapping Quad role names to weights",
        "type": "string"
      },
      "reasonText": {
        "description": "Required reason for the update",
        "type": "string"
      },
      "aotApproved": {
        "description": "Whether Arbiter-of-Truth approval has been recorded",
        "type": "boolean"
      },
      "adminApproved": {
        "description": "Whether admin approval has been recorded",
        "type": "boolean"
      },
      "safetyGatesPassed": {
        "description": "Whether safety gates have passed",
        "type": "boolean"
      },
      "expectedVersionsJson": {
        "description": "Optional JSON object mapping Quad role names to expected versions",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "turnId": {
        "description": "Owning session-log turn id",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "proposedBy": {
        "description": "Who proposed the update",
        "type": [
          "string",
          "null"
        ],
        "default": null
      },
      "metadataJson": {
        "description": "Optional JSON object of string metadata",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "workspacePath",
      "roleWeightsJson",
      "reasonText",
      "aotApproved",
      "adminApproved",
      "safetyGatesPassed"
    ]
  }
}