!element qbrain.server {
    strSessionLogHandlers = component "Session-Log and Review Handlers" "CQRS handlers of session-log turns and turn reviews (sections 4.2 and 5.2); each delegates to SessionLogService." "QBrainAi.Support.Mcp.SessionLog, IDispatcher" "Planned"
    strAgentContextHandlers = component "Agent-Context Handlers" "CQRS handlers of the stateless agent context: packages, responses and trust, and the relationship graph (section 6.5)." "QBrainAi.Support.Mcp.AgentContext, IDispatcher" "Planned"
    strWorkspaceResolutionBehavior = component "WorkspaceResolutionBehavior" "Pipeline behavior for every command and query: resolves the workspace or refuses with 400 validation_error, details.field workspacePath (section 3.5.1)." "IPipelineBehavior, QBrainAi.Support.Mcp.Workspaces" "Planned"
    strModeGateBehavior = component "ModeGateBehavior" "Pipeline behavior that refuses records marked IModeGatedRequest with 409 agent_context_disabled while Mcp:AgentContext:Mode is Off (section 3.5.1)." "IPipelineBehavior, QBrainAi.Support.Mcp.AgentContext" "Planned"
    strSharedComponents = component "Shared Components" "Logic shared by the units of work (3.5.2 to 3.5.5): SerializableWrite, IdempotentCreate, ReadableKeyAllocator, PagedQuery, SecretRedactor, TurnLocator, ScoreVerdict, SourceResolver." "QBrainAi.Support.Mcp" "Planned"
    strPackageAssembler = component "PackageAssembler" "Assembles a context package from a candidate snapshot: secrets, omissions, findings, token budget and rendering; replay reruns it on the stored snapshot (section 3.5.5)." "QBrainAi.Support.Mcp.AgentContext.Packages" "Planned"
    strCompletionGate = component "Completion Gate" "Server enforcement of the completion rule: a move into completed or failed is refused until requestClass and the required reviews are present (section 5.3)." "Policy CompletionGate, QBrainAi.Support.Mcp.SessionLog" "Planned"
}
strHostModel = softwareSystem "Agent Host Model" "The language model an agent host runs (for example behind Claude Code or Codex): it answers the operator prompt from the stateful history or from a stateless context package, and calls the plugin verbs and tools." "External"

