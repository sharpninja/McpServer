# AM1 model fragment (PLAN-C4MODEL-001 P4): the elements and relationships that
# docs/architecture/SessionTurn-Review-AgentContext-Architecture-Amendment-1-Durable-HV.md adds to the model. It reuses the
# SessionTurn elements of model/str.dsl and the as-built elements (D4). Converted once by SCRATCH/p4-am1/convert-am1.ps1 (D9);
# edit here from now on. Included after model/str.dsl (the CLI has no forward references).
!element qbrain.server {
    am1HvHandlers = component "Hostile Validation Handlers" "CQRS handlers of the HostileValidation bounded context, public and internal units (Amendment 1, section 14)." "QBrainAi.Support.Mcp.HostileValidation" "Planned"
    am1HvFinalizer = component "HV Finalization Handler" "FinalizeHvRequestCommand: verifies a closed run, then commits the whole HV result in one transaction (14.4)." "QBrainAi.Support.Mcp.HostileValidation" "Planned"
    am1HvWorkerHost = component "HV Worker Host" "One per workspace: sweeps, finalizes, files incidents, and claims and runs reviews and probes (section 16.1)." "BackgroundService, HvWorkerHost" "Planned"
    am1ReviewerAdapters = component "HV Reviewer Adapters" "One per reviewer: contained launch, live output lines, record extraction, runtime provenance (section 16.3)." "IHvReviewerAdapter" "Planned"
    am1ChangeEventBus = component "Change Event Bus" "In-memory change events; Amendment 1 uses it only to wake HV streams and the HV worker after a commit (R-16)." "IChangeEventBus (QBrainAi.Services)"
}

# As-built relationships of the as-built elements this fragment adds (evidence in each description)
qbrain.server.am1ChangeEventBus -> qbrain.server.servicesLib "Implemented in (ChannelChangeEventBus, src/QBrainAi.Services/Notifications/ChannelChangeEventBus.cs)" "Assembly"
qbrain.server.api -> qbrain.server.am1ChangeEventBus "Streams change events (EventStreamController, src/QBrainAi.Support.Mcp/Controllers/EventStreamController.cs line 31)" "In-process"

