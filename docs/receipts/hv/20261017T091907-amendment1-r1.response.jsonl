n32:         value => value == null ? 0 : WorkspaceIdentity.CanonicalizeWorkspaceId(value).GetHashCode(StringComparison.Ordinal),\n33:         value => value);\n34: \n35:     /// <summary>Applies the canonical converter and comparer to every workspace-key property in the model.</summary>\n36:     internal static void Apply(ModelBuilder modelBuilder)\n37:     {\n38:         foreach (var entityType in modelBuilder.Model.GetEntityTypes())\n39:         {\n40:             foreach (var property in entityType.GetDeclaredProperties())\n41:             {\n42:                 if (property.ClrType != typeof(string) || !PropertyNames.Contains(property.Name))\n43:                     continue;\n44: \n45:                 property.SetValueConverter(Converter);\n46:                 property.SetValueComparer(Comparer);\n47:             }\n48:         }\n49:     }\n50: \n51:     /// <summary>\n52:     /// Rewrites workspace-key values of added and modified entities to the canonical form in place, so\n53:     /// tracked instances returned by later queries carry the same value as the stored row. The comparer\n54:     /// treats raw and canonical spellings as equal, so an ordinary current-value assignment would be\n55:     /// ignored; the CLR member is written directly instead.\n56:     /// </summary>\n57:     internal static void CanonicalizeTrackedValues(IEnumerable<EntityEntry> entries)\n58:     {\n59:         foreach (var entry in entries)\n60:         {\n61:             if (entry.State is not (EntityState.Added or EntityState.Modified))\n62:                 continue;\n63: \n64:             foreach (var property in entry.Properties)\n65:             {\n66:                 if (!PropertyNames.Contains(property.Metadata.Name) || property.CurrentValue is not string current)\n67:                     continue;\n68: \n69:                 var canonical = WorkspaceIdentity.CanonicalizeWorkspaceId(current);\n70:                 if (string.Equals(current, canonical, StringComparison.Ordinal)