{"type":"item.completed","item":{"id":"item_253","type":"command_execution","command":"/usr/bin/pwsh -NoProfile -Command \"& './docs/receipts/hv/hv-r1-inspect.ps1' -Task Read -Path './docs/receipts/hv/hv-r1-related-requirements.json' -Start 1 -Count 190\"","aggregated_output":"SOURCE ./docs/receipts/hv/hv-r1-related-requirements.json totalLines=215\n1: {\n2:   \"Records\": [\n3:     {\n4:       \"priority\": \"medium\",\n5:       \"title\": \"Cross-Workspace TODO Move\",\n6:       \"status\": \"pending\",\n7:       \"area\": \"MCP\",\n8:       \"description\": \"The server shall support moving a TODO item from one workspace to another via REST (`POST /qbrainai/todo/{id}/move`) and STDIO (`todo_move` MCP tool), preserving all item fields including implementation tasks, requirements, and metadata. The move is implemented as create-in-target then delete-from-source.\\n\\n**Covered by:** `TodoController.MoveAsync`, `FwhMcpTools.TodoMove`, `TodoMoveRequest`, `TodoServiceResolver`\",\n9:       \"createdAt\": \"2026-10-17T14:25:08.7473992+00:00\",\n10:       \"scopeStartLayerKey\": \"layer-1\",\n11:       \"updatedAt\": \"2026-10-17T14:25:08.7474386+00:00\",\n12:       \"id\": \"FR-MCP-045\",\n13:       \"acceptanceCriteria\": []\n14:     },\n15:     {\n16:       \"priority\": \"medium\",\n17:       \"title\": \"Artifact links resolve through MCP APIs\",\n18:       \"status\": \"pending\",\n19:       \"area\": \"MCP\",\n20:       \"description\": \"Artifact links resolve only through supported MCP APIs (TODO, FR/TR/TEST, session log, triage, plans, files, commits, generated docs). Missing, unauthorized, stale, or ambiguous links produce diagnostics, not silent omission.\",\n21:       \"createdAt\": \"2026-10-17T14:25:08.8469341+00:00\",\n22:       \"scopeStartLayerKey\": \"layer-1\",\n23:       \"updatedAt\": \"2026-10-17T14:25:08.8469716+00:00\",\n24:       \"id\": \"FR-MCP-HOSTILEREVIEW-002\",\n25:       \"acceptanceCriteria\": [\n26:         {\n27:           \"text\": \"Missing link produces a diagnostic, not silent omit.\",\n28:           \"evidence\": \"tests/QBrainAi.Support.Mcp.Tests/Services/HostileReviewG4OverlayTests.cs; overlay G4 rereview SHA-256 BFD7029944F1EAAC99F2808EA47146DBBD7C87EEB3E02AB4ADC31F95D3F0DFD1\",\n29:           \"isSatisfied\": true,\n30:           \"id\": \"\"\n31:         },\n32:         {\n33:           \"text\": \"Unauthorized or stale or ambiguous link produces a diagnostic, not silent omit.\",\n34:           \"evidence\": \"tests/QBrainAi.Support.Mcp.Tests/Services/HostileReviewG4OverlayTests.cs; overlay G4 rereview SHA-256 BFD7029944F1EAAC99F2808EA47146DBBD7C87EEB3E02AB4ADC31F95D3F0DFD1\",\n35:           \"isSatisfied\": true,\n36:           \"id\": \"\"\n37:         },\n38:         {\n39:           \"text\": \"Successful resolve stores the resolved artifact identity and hash when available.\",\n40:           \"evidence\": \"tests/QBrainAi.Support.Mcp.Tests/Services/HostileReviewG4OverlayTests.cs; overlay G4 rereview SHA-256 BFD7029944F1EAAC99F2808EA47146DBBD7C87EEB3E02AB4ADC31F95D3F0DFD1\",\n41:           \"isSatisfied\": true,\n42:           \"id\": \"\"\n43:         },\n44:         {\n45:           \"text\": \"Authorize each artifact at submit and reauthorize it at every dispatch. Resolve only through supported workspace-scoped services. Store only normalized identity, type, version/hash, and sanitized diagnostic metadata. Permit no raw artifact or assembled prompt in queue rows, notifications, logs, receipts, or result metadata. Reject more than 64 links, an artifact over 1 MiB decoded, aggregate resolved input over 8 MiB, or unsupported/binary content that cannot be inspected safely.\",\n46:           \"evidence\": \"tests/QBrainAi.Support.Mcp.Tests/Services/HostileReviewG4OverlayTests.cs; overlay G4 rereview SHA-256 BFD7029944F1EAAC99F2808EA47146DBBD7C87EEB3E02AB4ADC31F95D3F0DFD1\",\n47:           \"isSatisfied\": true,\n48:           \"id\": \"\"\n49:         }\n50:       ]\n51:     },\n52:     {\n53:       \"priority\": \"medium\",\n54:       \"title\": \"Reviewer run records model effort identity\",\n55:       \"status\": \"pending\",\n56:       \"area\": \"MCP\",\n57:       \"description\": \"Each reviewer execution records model, effort, agent identity, plugin/source, prompt template/version, run id, timestamps, and token/runtime metadata when available. Missing metadata is omitted with a diagnostic, never fabricated.\",\n58:       \"createdAt\": \"2026-10-17T14:25:08.8486792+00:00\",\n59:       \"scopeStartLayerKey\": \"layer-1\",\n60:       \"updatedAt\": \"2026-10-17T14:25:08.8487193+00:00\",\n61:       \"id\": \"FR-MCP-HOSTILEREVIEW-003\",\n62:       \"acceptanceCriteria\": [\n63:         {\n64:           \"text\": \"Execution row records model string, effort level, agent identity, plugin/source surface.\",\n65:           \"evidence\": \"tests/QBrainAi.Support.Mcp.Tests/Services/HostileReviewG4OverlayTests.cs; overlay G4 rereview SHA-256 BFD7029944F1EAAC99F2808EA47146DBBD7C87EEB3E02AB4ADC31F95D3F0DFD1\",\n66:           \"isSatisfied\": true,\n67:           \"id\": \"\"\n68:         },\n69:         {\n70:           \"text\": \"Execution row records prompt template id and version, run id, start/end UTC.\",\n71:           \"evidence\": \"tests/QBrainAi.Support.Mcp.Tests/Services/HostileReviewG4OverlayTests.cs; overlay G4 rereview SHA-256 BFD7029944F1EAAC99F2808EA47146DBBD7C87EEB3E02AB4ADC31F95D3F0DFD1\",\n72:           \"isSatisfied\": true,\n73:           \"id\": \"\"\n74:         },\n75:         {\n76:           \"text\": \"Token/runtime metadata stored when provided; omitted with diagnostic when not provided, not fabricated.\",\n77:           \"evidence\": \"tests/QBrainAi.Support.Mcp.Tests/Services/HostileReviewG4OverlayTests.cs; overlay G4 rereview SHA-256 BFD7029944F1EAAC99F2808EA47146DBBD7C87EEB3E02AB4ADC31F95D3F0DFD1\",\n78:           \"isSatisfied\": true,\n79:           \"id\": \"\"\n80:         },\n81:         {\n82:           \"text\": \"A server-owned worker uses the existing agent infrastructure with the agent, model and effort configured for it when they are configured, and otherwise the pooled default agent with its default model and effort; no requirement names a specific model (operator rule 2026-10-15; PLAN-SESSIONTRIAGEFIX-001 B9). Queue state is durable. Request, attempt, pool-job, model-execution, and accepted-terminal-result identities are distinct. Model execution is bounded at-least-once across process loss. Lease loss, repeated model execution, or duplicate completion cannot produce more than one accepted terminal result. Cancellation is internal to host/workspace lifecycle handling and existing authorized AgentPool cancellation, never a public hostile-review mutation.\",\n83:           \"isSatisfied\": false,\n84:           \"id\": \"\"\n85:         }\n86:       ]\n87:     },\n88:     {\n89:       \"priority\": \"medium\",\n90:       \"title\": \"Failsafe replay, child deadline, and contention classification\",\n91:       \"status\": \"pending\",\n92:       \"area\": \"MCP\",\n93:       \"description\": \"One child deadline covers asynchronous stdin and stdout and process-tree cleanup. Hook default bound is 30 seconds. Codex failsafe identity stays Codex when PLUGIN_AGENT_NAME or MCP_AGENT_NAME is inherited as Grok. Quarantine files 3358, d5f9, and 9ad7 are repaired, replayed even when drainAttempts is exhausted, and deleted only after durable success. Import recovery scans pending importRecovery yaml, persists a mapped DTO, and deletes only that envelope after persisted true and degraded false. Busy, locked, budget expiry, and wrapped contention are retryable. Connection outage is backend_unavailable. Automatic and explicit drain do not latch completion on contention.\",\n94:       \"createdAt\": \"2026-10-17T14:25:08.9600638+00:00\",\n95:       \"scopeStartLayerKey\": \"layer-1\",\n96:       \"updatedAt\": \"2026-10-17T14:25:08.9601024+00:00\",\n97:       \"id\": \"FR-MCP-SESSIONLIFE-004\",\n98:       \"acceptanceCriteria\": [\n99:         {\n100:           \"text\": \"One bounded child-process deadline, default 30 seconds for the hook operation, covers stdin writes, stdout and stderr reads, wait, cancellation, and process-tree cleanup without a stranded child or premature disposal race.\",\n101:           \"isSatisfied\": false,\n102:           \"id\": \"\"\n103:         },\n104:         {\n105:           \"text\": \"Codex child execution preserves Codex agent identity and workspace-scoped cache ownership even when inherited environment variables identify Grok or another agent.\",\n106:           \"isSatisfied\": false,\n107:           \"id\": \"\"\n108:         },\n109:         {\n110:           \"text\": \"Quarantine repair accepts historical supported shapes through object-first parsing, fills only missing values with None, preserves valid values, and never fabricates identity.\",\n111:           \"isSatisfied\": false,\n112:           \"id\": \"\"\n113:         },\n114:         {\n115:           \"text\": \"Contention and service outage remain distinct classified outcomes; both drain entry points retain retryable work without consuming attempts or latching completion and later replay exactly once. When storage is actually unavailable, health.storage reports unreachable; contention is not mislabeled as storage-down.\",\n116:           \"isSatisfied\": false,\n117:           \"id\": \"\"\n118:         },\n119:         {\n120:           \"text\": \"Import-recovery ingestion accepts a validated canonical session bundle or reconstructs the complete bundle from verified sources, never submits the importRecovery envelope as a session, and preserves all files on failure.\",\n121:           \"isSatisfied\": false,\n122:           \"id\": \"\"\n123:         },\n124:         {\n125:           \"text\": \"Path containment, reparse-point containment, size and count bounds, source identity, and canonical schema are verified before any source or recovery artifact is read or persisted.\",\n126:           \"isSatisfied\": false,\n127:           \"id\": \"\"\n128:         },\n129:         {\n130:           \"text\": \"Partial and canceled replay remains retryable and idempotent; concurrent replay cannot duplicate work; only the exact unchanged recovery artifact is deleted after verified durable persistence.\",\n131:           \"isSatisfied\": false,\n132:           \"id\": \"\"\n133:         }\n134:       ]\n135:     },\n136:     {\n137:       \"priority\": \"medium\",\n138:       \"title\": \"Stop hook stale pin and session-log uniqueness\",\n139:       \"status\": \"pending\",\n140:       \"area\": \"MCP\",\n141:       \"description\": \"Stop hook runs failed-build and incomplete-audit gates first. It allows a stale pin only when authoritative server completion shows the local request id is not the active turn. A genuinely active different request id is not cleared. Both timestamp and lastUpdated stale is the age case. A fresh lastUpdated alone must not pass a stale pin. BUG-TRIAGE-229 is predecessor-schema detection before save, classified provider text in details.inner, and one bounded uniqueness retry.\",\n142:       \"createdAt\": \"2026-10-17T14:25:08.9612756+00:00\",\n143:       \"scopeStartLayerKey\": \"layer-1\",\n144:       \"updatedAt\": \"2026-10-17T14:25:08.9613041+00:00\",\n145:       \"id\": \"FR-MCP-SESSIONLIFE-005\",\n146:       \"acceptanceCriteria\": [\n147:         {\n148:           \"text\": \"Failed-build and incomplete-audit enforcement executes before any stale-pin allow, timestamp refresh, auto-close, or recovery that could bypass those gates.\",\n149:           \"isSatisfied\": false,\n150:           \"id\": \"\"\n151:         },\n152:         {\n153:           \"text\": \"A stale local in_progress turn is reconciled only by authoritative Completed proof for the exact workspace, agent, session, and request; active, missing, ambiguous, or unavailable proof fails closed and retains state.\",\n154:           \"isSatisfied\": false,\n155:           \"id\": \"\"\n156:         },\n157:         {\n158:           \"text\": \"Old, fresh, missing, and invalid timestamp and lastUpdated combinations, completed or missing local files, and mismatched request IDs are covered; recency alone never proves completion.\",\n159:           \"isSatisfied\": false,\n160:           \"id\": \"\"\n161:         },\n162:         {\n163:           \"text\": \"Schema-predecessor failures are detected before mutation and provider errors retain a classified details.inner diagnostic without leaking credentials.\",\n164:           \"isSatisfied\": false,\n165:           \"id\": \"\"\n166:         },\n167:         {\n168:           \"text\": \"One bounded retry applies only to the known unique same-session/request race; the winner is reread and merged without duplicate children or loss of unrelated state, while unrelated failures and cancellation propagate.\",\n169:           \"isSatisfied\": false,\n170:           \"id\": \"\"\n171:         }\n172:       ]\n173:     },\n174:     {\n175:       \"priority\": \"medium\",\n176:       \"title\": \"Stop-hook stale pin and upsert uniqueness\",\n177:       \"status\": \"pending\",\n178:       \"area\": \"MCP\",\n179:       \"description\": \"Close-PluginTurnIfNeeded runs build and audit gates first and allows a stale pin only with authoritative server completion. SessionLogSchemaGuard, SessionLogService.UpsertTurnAsync, and SessionLogController implement predecessor-schema detection, details.inner, and one uniqueness retry.\\n**Covered by:** FR: FR-MCP-SESSIONLIFE-005; TEST: TEST-MCP-SESSIONLIFE-002, TEST-MCP-SESSIONLIFE-004\",\n180:       \"subarea\": \"SESSIONLIFE\",\n181:       \"createdAt\": \"2026-10-17T14:25:13.0769027+00:00\",\n182:       \"scopeStartLayerKey\": \"layer-1\",\n183:       \"updatedAt\": \"2026-10-17T14:25:13.0769316+00:00\",\n184:       \"id\": \"TR-MCP-SESSIONLIFE-005\",\n185:       \"acceptanceCriteria\": [\n186:         {\n187:           \"text\": \"Stop enforcement obtains exact-turn server proof through the supported typed client after build and audit gates and before any state mutation.\",\n188:           \"isSatisfied\": false,\n189:           \"id\": \"\"\n190:         },\nEXIT_CODE=0\n","exit_code":0,"status":"completed"}}
