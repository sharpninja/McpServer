{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/pwsh -NoProfile -Command \"pwsh.exe -NoProfile -NonInteractive -File './docs/receipts/hv/hv-r1-inspect.ps1' -Task Read -Path '/home/sharpninja/.codex/plugins/cache/mcpserver-codex-plugin/mcpserver/1.120.0/lib/resolve-cache-dir.ps1' -Count 160\"","aggregated_output":"SOURCE /home/sharpninja/.codex/plugins/cache/mcpserver-codex-plugin/mcpserver/1.120.0/lib/resolve-cache-dir.ps1 totalLines=613\n1: <#\n2: .SYNOPSIS\n3:     Resolve the workspace-scoped PowerShell plugin cache directory.\n4: .DESCRIPTION\n5:     Runtime state belongs to the active workspace, never to the installed\n6:     plugin checkout. The returned path is <workspace>/.mcpServer/<agent>.\n7: \n8:     Precedence:\n9:       1. MCP_CACHE_DIR_OVERRIDE for an explicit test or recovery override.\n10:       2. The workspace marker found from the explicit or active start path.\n11:       3. MCP/host workspace environment variables as a markerless fallback.\n12:  #>\n13: \n14: $script:ResolveCacheDirScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path\n15: \n16: function Get-McpCacheAgentKey {\n17:     [CmdletBinding()]\n18:     param()\n19: \n20:     # FR-MCP-SESSIONLIFE-002: inherited Grok variables must not move a Codex\n21:     # plugin into the Grok cache namespace.\n22:     $inheritedAgent = @($env:PLUGIN_AGENT_NAME, $env:MCP_AGENT_NAME) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -First 1\n23:     if ($env:MCP_PLUGIN_HOST -match '^(?i:codex)$' -and $inheritedAgent -match '(?i)grok') {\n24:         return 'codex'\n25:     }\n26: \n27:     $agent = @(\n28:         $env:MCP_AGENT_NAME,\n29:         $env:PLUGIN_AGENT_NAME,\n30:         $env:PLUGIN_AGENT_DEFAULT,\n31:         $env:MCP_PLUGIN_HOST\n32:     ) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -First 1\n33: \n34:     if (-not $agent) { return 'default' }\n35: \n36:     switch ($agent.Trim().ToLowerInvariant()) {\n37:         'claude' { return 'claude' }\n38:         'claudecode' { return 'claude' }\n39:         'claude-code' { return 'claude' }\n40:         'claudecowork' { return 'cowork' }\n41:         'claude-cowork' { return 'cowork' }\n42:         'codex' { return 'codex' }\n43:         'copilot' { return 'copilot' }\n44:         'grok' { return 'grok' }\n45:         'grokcode' { return 'grok' }\n46:         'grok-code' { return 'grok' }\n47:         'cline' { return 'cline' }\n48:         'cline-v2' { return 'cline' }\n49:         'opencode' { return 'opencode' }\n50:         'open-code' { return 'opencode' }\n51:     }\n52: \n53:     $key = ($agent.Trim() -replace '[^A-Za-z0-9]+', '-').Trim('-').ToLowerInvariant()\n54:     if (-not $key) { return 'default' }\n55:     return $key\n56: }\n57: \n58: function Get-McpPluginRoot {\n59:     if ($env:MCP_PLUGIN_ROOT) { return $env:MCP_PLUGIN_ROOT }\n60:     if ($env:CLAUDE_PLUGIN_ROOT) { return $env:CLAUDE_PLUGIN_ROOT }\n61:     return (Split-Path -Parent $script:ResolveCacheDirScriptDir)\n62: }\n63: \n64: function Join-McpWorkspaceCachePath {\n65:     param([Parameter(Mandatory)][string]$WorkspacePath)\n66: \n67:     return (Join-Path (Join-Path $WorkspacePath '.mcpServer') (Get-McpCacheAgentKey))\n68: }\n69: \n70: function Get-McpBackgroundScopeKey {\n71:     <#\n72:     .SYNOPSIS\n73:         TR-MCP-PLUGIN-013 AC-005 (PLAN-SESSIONTRIAGEFIX-001 D3): the identity of a background host: MCP_SUBAGENT_ID, else GROK_SUBAGENT_ID,\n74:         else the hook payload's session_id. None when there is none or when it equals the agentSessionId recorded for the root, because\n75:         then the prompt is the root host's own.\n76:     #>\n77:     [CmdletBinding()]\n78:     param(\n79:         [string]$PayloadSessionId,\n80:         [string]$RootAgentSessionId\n81:     )\n82: \n83:     $key = @($env:MCP_SUBAGENT_ID, $env:GROK_SUBAGENT_ID, $PayloadSessionId) |\n84:         Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -First 1\n85:     if ([string]::IsNullOrWhiteSpace($key)) { return $null }\n86:     $key = $key.Trim()\n87:     if (-not [string]::IsNullOrWhiteSpace($RootAgentSessionId) -and\n88:         [string]::Equals($key, $RootAgentSessionId.Trim(), [System.StringComparison]::Ordinal)) {\n89:         return $null\n90:     }\n91:     return $key\n92: }\n93: \n94: function Join-McpBackgroundScopePath {\n95:     <#\n96:     .SYNOPSIS\n97:         TR-MCP-PLUGIN-013 AC-005 (D3): the cache folder of one background host, <cache>/background/<key>. A key with characters other than\n98:         letters, digits, dot, underscore and hyphen, or longer than 96 characters, is made file-safe and suffixed with a hash of the\n99:         original, so two keys never share a folder.\n100:     #>\n101:     [CmdletBinding()]\n102:     param(\n103:         [Parameter(Mandatory)][string]$CacheDir,\n104:         [Parameter(Mandatory)][string]$Key\n105:     )\n106: \n107:     $safe = ($Key -replace '[^A-Za-z0-9._-]+', '-').Trim('-', '.')\n108:     if ($safe -cne $Key -or $safe.Length -gt 96) {\n109:         $hash = [System.Convert]::ToHexString([System.Security.Cryptography.SHA256]::HashData([System.Text.Encoding]::UTF8.GetBytes($Key))).Substring(0, 12).ToLowerInvariant()\n110:         if ($safe.Length -gt 80) { $safe = $safe.Substring(0, 80) }\n111:         $safe = if ($safe) { \"$safe-$hash\" } else { $hash }\n112:     }\n113:     return (Join-Path (Join-Path $CacheDir 'background') $safe)\n114: }\n115: \n116: function Resolve-McpBackgroundScopeCacheDir {\n117:     <#\n118:     .SYNOPSIS\n119:         TR-MCP-PLUGIN-013 AC-005 (D3): the cache a session-log verb the agent calls itself uses. With no MCP_CACHE_DIR_OVERRIDE and with\n120:         MCP_SUBAGENT_ID or GROK_SUBAGENT_ID set, that agent's background folder when it holds a current-turn.yaml; otherwise CacheDir.\n121:         Those two are the only host identities an agent's own calls carry.\n122:     #>\n123:     [CmdletBinding()]\n124:     param([Parameter(Mandatory)][string]$CacheDir)\n125: \n126:     if ($env:MCP_CACHE_DIR_OVERRIDE) { return $CacheDir }\n127:     $key = @($env:MCP_SUBAGENT_ID, $env:GROK_SUBAGENT_ID) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -First 1\n128:     if ([string]::IsNullOrWhiteSpace($key)) { return $CacheDir }\n129:     $scope = Join-McpBackgroundScopePath -CacheDir $CacheDir -Key $key.Trim()\n130:     if (Test-Path -LiteralPath (Join-Path $scope 'current-turn.yaml') -PathType Leaf) { return $scope }\n131:     return $CacheDir\n132: }\n133: \n134: function Get-McpWorkspaceFromEnvironment {\n135:     $configured = @(\n136:         $env:MCPSERVER_WORKSPACE_PATH,\n137:         $env:MCP_WORKSPACE_PATH,\n138:         $env:CLAUDE_PROJECT_DIR,\n139:         $env:CODEX_WORKSPACE_PATH,\n140:         $env:CODEX_PROJECT_DIR,\n141:         $env:COWORK_WORKSPACE_PATH,\n142:         $env:CLINE_WORKSPACE_PATH,\n143:         $env:OPENCODE_WORKSPACE_PATH\n144:     ) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -First 1\n145: \n146:     if ($configured -and (Test-Path -LiteralPath $configured -PathType Container)) {\n147:         return (Resolve-Path -LiteralPath $configured).ProviderPath\n148:     }\n149: \n150:     return $null\n151: }\n152: \n153: function Resolve-McpCacheDir {\n154:     [CmdletBinding()]\n155:     param([string]$StartPath)\n156: \n157:     if ($env:MCP_CACHE_DIR_OVERRIDE) {\n158:         return $env:MCP_CACHE_DIR_OVERRIDE\n159:     }\n160: \nEXIT_CODE=0\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/pwsh -NoProfile -Command \"pwsh.exe -NoProfile -NonInteractive -File './docs/receipts/hv/hv-r1-inspect.ps1' -Task MarkerInstructions -Count 400\"","aggregated_output":"RUNTIME INSTRUCTIONS totalLines=207; connection fields withheld\n1: You are connected to an MCP Context Server at http://LAB-OMARCHY:7147. Use this server to coordinate your work.\n2: \n3: ## Session Start (Run Once Per Session)\n4: 1. Read this marker file for connection details and API key.\n5: 2. Bootstrap the required plugin named for your agent in the top-level `agent_plugins` contract. Get the plugin through the MCP Server tool registry before relying on local root hints: search `/mcpserver/tools/search?keyword=<plugin_name>` for the installed tool definition and select the result whose `name` exactly equals `<plugin_name>`; if that exact tool definition is missing, install the definition from `/mcpserver/tools/buckets/official/install?toolName=<plugin_name>`, then search again. Execute the exact tool definition's returned `commandTemplate` with `targetParent` set to the plugin parent directory to clone or update the plugin repository. Codex must use `mcpserver-codex-plugin`; Claude must use `mcpserver-claude-code-plugin`; Copilot must use `mcpserver-copilot-plugin`; Cline must use `mcpserver-cline-plugin`; Grok must use `mcpserver-grok-plugin`.\n6: 3. Verify the marker signature using the workspace API key in this file before contacting the server.\n7: 4. Call /health with a random nonce and confirm the response echoes that exact nonce.\n8: 5. Verify and log plugin identity before other MCP work: sourceType, plugin name/version, plugin root or MCP server name, marker signature result, health nonce result, and workspace path.\n9: 6. Review recent session history and current TODOs only after signature, nonce, and plugin verification succeed.\n10: 7. Post an initial session log turn for the session.\n11: \n12: ## Required Agent Plugins\n13: - `agent_plugins.policy` is `required`. The plugin contract or deterministic digest is covered by marker signature verification. - Plugin acquisition is the bootstrap exception to the normal plugin-only rule: if the matching plugin is not already available locally, use the authenticated tool registry endpoints in this marker to locate/install the matching `mcpserver-*-plugin` tool definition from the `official` bucket and run its clone/update command. After acquisition, bootstrap and use the matching plugin for normal MCP work. - If your matching plugin cannot be acquired through the tool registry or remains unavailable after acquisition, stop MCP usage, record `MCP_PLUGIN_UNAVAILABLE:<Agent>`, and continue only with non-MCP local diagnosis. - Do not substitute raw REST, generic `mcpserver-repl`, helper modules, or another agent's plugin for normal session, TODO, requirements, import/export, or traceability operations. - Another agent's plugin may be inspected only for read-only diagnosis of plugin installation or contract drift. - Normal workspace shell commands use `pwsh.exe`. Plugin-owned hooks may use the runner declared by that plugin contract. - Codex plugin tools/hooks must satisfy `agent_plugins.agents.Codex`; Claude plugin tools/hooks must satisfy `agent_plugins.agents.Claude`; Copilot plugin tools/hooks must satisfy `agent_plugins.agents.Copilot`; Cline MCP tools must satisfy `agent_plugins.agents.Cline`; Grok plugin skills/hooks/MCP server declarations must satisfy `agent_plugins.agents.Grok`. - For Grok, the Streamable HTTP MCP server exposes tool names such as `sessionlog_*`, `todo_*`, `requirements_*`, and memory tools when available; hosted-agent `mcp_*` names are not expected from that transport. `workflow.sessionlog.*`, `workflow.todo.*`, `workflow.memory.*`, and `workflow.requirements.*` are plugin shim/REPL method names used by the Grok skills and `repl-invoke` helpers; they are not expected to appear as literal `search_tool` results. - Local plugin root hints in `agent_plugins.agents.<Agent>.root_hints` are fallback verification hints after tool-registry acquisition, not the primary install source. - Claude Code agents must trigger the `claude-hook-validation` skill during marker/plugin bootstrap. That skill validates active Claude settings for MCP `UserPromptSubmit`, `Stop`, and `PostToolUse` hook commands from `hooks/hooks.json`; if any required hook is missing, it uses `install-claude-mcp-hooks.ps1` from the `claude-hook-wiring` skill to merge MCP hooks into active Claude settings without replacing existing hooks. Restart Claude Code after the skill reports installed hooks.\n14: \n15: ## Model-Authored Session Logging\n16: - Models must write MCP Session Log turns, dialog, actions, decisions, and completions themselves through the active agent's session-log surface (`workflow.sessionlog.*`, `sessionlog_*`, `mcp_session_*`, or equivalent plugin tool).\n17: - Plugins must not ingest local chat transcripts to populate normal session logs and must not expose transcript-ingestion helpers, skills, endpoint shortcuts, or parser forks.\n18: - Transcript ingestion and normalization are explicit non-plugin server/client/REPL/MCP operations. Use them only when the user asks to import or normalize transcript files, not as a substitute for live model-authored logging.\n19: ## MCP Requirements Visibility\n20: - When implementing or enforcing requirements, query current effective requirements for the active workspace layer through the active agent's requirements surface (`workflow.requirements.effective`, `client.Requirements.GetEffectiveRequirementsAsync`, `req_effective`, or equivalent plugin tool). Use the layer catalog surface (`workflow.requirements.listLayers/createLayer/updateLayer`, `client.Requirements.ListRequirementLayersAsync/CreateRequirementLayerAsync/UpdateRequirementLayerAsync`, `req_list_layers/req_create_layer/req_update_layer`, or equivalent plugin tools) when the user asks to inspect or manage requirement layers. Do not treat raw all-requirements lists, exported markdown, or future-layer requirements as currently enforceable unless the user explicitly asks to inspect or plan those layers.\n21: ## YAML Mutation Rule\n22: \n23: - Never edit YAML files by appending, replacing, or removing text lines. This includes one-key configuration changes.\n24: \n25: - Always deserialize the complete document into an object, mutate the object, serialize it, and save the serialized result.\n26: \n27: - For PowerShell work, use `plugins/core/lib-ps/yaml-object-mutation.ps1` and call `Set-McpYamlObjectValue` or `Update-McpYamlObject`. Do not build YAML snippets as strings or use line-oriented edit helpers for YAML.\n28: \n29: ## MCP and Plugin Failure Reporting\n30: - MCP Server failures and required-plugin failures discovered while working must always be written as a normal failsafe YAML report. Use the plugin/REPL failsafe or pending YAML queue and preserve the triage method (`workflow.triage.report`, `triage_report`, or equivalent plugin triage tool) plus title, summary, observed behavior, expected behavior, severity, component, workspace path, dedupe key or error signature, affected paths, evidence, reproduction hints, tags, reporter agent, session id, turn id, and current TODO id when known.\n31: - After the failsafe YAML is written and triage submission succeeds, continue the user's active task. Do not wait for triage research, TODO creation, or resolution.\n32: - Do not create TODOs, requirements, GitHub issues, manual repair plans, or alternate reports for MCP Server/plugin failures unless the user's active request is to fix that failure.\n33: - If the MCP Server or required-plugin failure reveals that code, docs, requirements, plugin skills, package sync, deployment, configuration, or other artifacts need to be updated as a separate repair workflow, write a detailed triage report that includes the needed changes, acceptance criteria, and validation evidence, then continue the active task after the failsafe YAML is written and triage submission succeeds.\n34: - If triage submission fails, stop work and notify the user. Keep the failsafe YAML report for later replay; do not use raw REST or another reporting channel as a substitute.\n35: \n36: ## Agent Help (MCP Server issues)\n37: When you are stuck on any MCP Server surface (marker trust, plugin bootstrap, session log, TODO, requirements, triage, memory, context search, federation, hooks, or API behavior), request expert help instead of improvising raw REST bypasses.\n38: - **When to invoke:** signature or health nonce failures you cannot resolve; unexpected tool or plugin behavior; `MCP_PLUGIN_UNAVAILABLE`; repeated 401/503 after re-reading this marker; documentation contradictions.\n39: - **How to invoke:** preferred `workflow.agenthelp.createSession` or MCP tool `agent_help_create_session` with caller linkage (`callerAgent`, `callerSessionId`, `callerRequestId`) and a factual issue summary (observation vs inference separated). REST: `POST /mcpserver/agent-help/session` then WebSocket `/mcpserver/agent-help/session/{id}/stream` (SSE fallback: `POST .../turn/stream`).\n40: - **Caller obligations:** include reproduction steps, exact error text, and files already consulted. Do not instruct the helper to ignore guardrails, skip triage, or mutate TODO/session-log/requirements storage directly.\n41: - Agent help is for diagnosis and coordination, not a substitute for the required plugin route for normal MCP work.\n42: \n43: ## MCP Memories\n44: MCP memories are durable operator guidance managed by the MCP Server. Global memories apply to every workspace; Workspace memories apply only to the active workspace. Memory IDs use `MEMORY-{CATEGORY}-{NNN}`.\n45: Agents that support request-boundary injection must render required memories exactly as:\n46: REQUIRED MEMORIES - MEMORY-REQ-001: Raw memory text.\n47: If no required memories are visible, render:\n48: REQUIRED MEMORIES - None.\n49: Preserve raw memory text exactly; do not summarize, paraphrase, reorder within a scope, silently generate new memories, or add secrets. MCP memories are not a secret store. Effective memory order is Global memories first sorted by ID, then current Workspace memories sorted by ID.\n50: Existing agent-local memory stores are caches or migration sources only; the MCP memory store is the authoritative shared record. Import agent-local memories only when the operator approves the scope, the content belongs to this workspace or is intentionally Global, and the import does not leak secrets, private notes, or unrelated workspace guidance.\n51: Attribute memory mutations with the real agent or user identity via `updatedBy` when supported, and record successful memory add/update/remove operations in the active session log through `workflow.sessionlog.appendActions`. Keep import provenance in the session log or dialog instead of adding private source paths to memory text.\n52: Manage memories through the required plugin or MCP tool surface: `memory_add`, `memory_list`, `memory_update`, `memory_remove`, `memory_remember`, `memory_recall`, `memory_explore`, `memory_consolidate`, `memory_promote`, `memory_revert`; REPL `workflow.memory.add`, `workflow.memory.list`, `workflow.memory.update`, `workflow.memory.remove`, `workflow.memory.remember`, `workflow.memory.recall`, `workflow.memory.explore`, `workflow.memory.consolidate`, `workflow.memory.promote`, `workflow.memory.revert`; or REST `/mcpserver/memory` when explicitly allowed for non-plugin diagnostics.\n53: \n54: ## Codex MCP Quickstart\n55: If you are Codex, use the Codex plugin wrappers before direct REPL calls:\n56: 1. Run `Invoke-CodexMcpPlugin.ps1 -Command Status` from the `mcpserver-codex-plugin` root to verify plugin root, marker trust, health nonce, workspace path, session id, current turn, and supported namespaces.\n57: 2. Invoke MCP workflow methods with `Invoke-CodexMcpPlugin.ps1 -Command Invoke -Method <method> -Params <yaml>` so YAML parameters are passed through stdin instead of fragile nested shell quoting.\n58: 3. Complete the session-log turn intentionally with `Invoke-CodexMcpPlugin.ps1 -Command CompleteTurn -Response <final response>` before the final answer when the stop gate cannot infer completion.\n59: 4. For `mcpserver-repl --agent-stdio`, send one single-line JSON request envelope per stdin line. Do not send formatted YAML or a single `type: batch` envelope; batch envelopes are rejected with `unsupported_batch_envelope`.\n60: \n61: ## PowerShell.MCP Command Routing\n62: For every PowerShell Core (`pwsh`) invocation on every operating system:\n63: - Use PowerShell.MCP 1.14.0 or newer from PSGallery as the command runner. Install or update it with `Install-PSResource PowerShell.MCP` when the agent environment does not provide a current version.\n64: - `execute_command` is the primary MCP tool for PowerShell cmdlets, CLI tools, navigation, builds, tests, file-system work, and process management. Do not use the removed `invoke_expression` name. Host-qualified names depend on the configured server key: for example, `mcp__powershell__execute_command` for `powershell` and `mcp__pwsh__execute_command` for `pwsh`.\n65: - Calling `start_console` first is optional because `execute_command` auto-starts or reuses a console. Call `start_console` explicitly only to pre-warm at `start_location`, show a banner, allocate a sub-agent console, or force an additional console by supplying `reason`; omit `reason` when reuse is preferred.\n66: - Use `get_current_location` when the current PowerShell context matters. For a sub-agent, call `start_console` with `is_subagent=true`, retain the returned `agent_id`, and pass it on every later PowerShell.MCP tool call.\n67: - When a command continues after the call returns, use `wait_for_completion` to retrieve the cached result instead of running `Start-Sleep`. Use `cancel` for an interruptible pipeline or native CLI, and `close_console` for a non-interruptible command or PowerShell host prompt. If `close_console` reports that a human is typing, only repeat the same PID call when confirming that the console should be closed.\n68: - In 1.14.0, blocking timeouts are end-to-end deadlines and are capped at 170 seconds for Claude Code and 50 seconds for other or unidentified clients unless a lower limit applies. A timed-out command keeps running and its result is cached for a later tool call.\n69: - Route `pwsh` commands through a PowerShell.MCP session instead of launching ad hoc PowerShell processes. On Windows, reuse one session for the workspace and route `node` invocations through it as well.\n70: - When PowerShell.MCP must launch PowerShell Core directly, invoke `pwsh.exe` with `-NoProfile -NonInteractive`. Do not use `powershell.exe`.\n71: - The PowerShell escape character is the backtick `` ` ``, not the backslash. Never use C or bash-style `\\\"` escaping inside PowerShell command strings.\n72: - Prefer single-quoted PowerShell strings for literal regex, paths, JSON/YAML snippets, and text containing pipeline characters such as `|`.\n73: - When a command needs nested quoting, choose one of these patterns before improvising: `-File` with explicit arguments; piping stdin to the called tool or script; single-quoted or double-quoted here-strings; `-EncodedCommand` for complex inline PowerShell; or correct backtick escaping for embedded PowerShell quotes.\n74: - If a regex or literal argument contains `|`, `&`, `;`, parentheses, braces, or quotes, verify it is inside a single PowerShell argument before running.\n75: - For text reads and edits inside PowerShell.MCP, use `Show-TextFiles`, `Add-LinesToFile`, `Update-LinesInFile`, `Update-MatchInFile`, and `Remove-LinesFromFile`; pass literal content through `var1` to `var4`. Version 1.12.0 and newer stage replacements beside the target, so do not apply the obsolete same-volume `TEMP`/`TMP` workaround. Re-read or diff every edit before claiming it landed.\n76: ## Byrd Development Process\n77: `Byrd Dev Process`, `BDP`, `BPDv4`, and `Byrd Development Process` refer to `F:\\GitHub\\McpServer\\docs\\Development-Process-draft-v4.md`.\n78: \n79: ## Federation Topology\n80: - To identify hub/proxy topology, call the supported federation status surface, preferably through your required plugin or client wrapper: `/mcpserver/federation/status`. - Status fields to report when relevant: `role`, `configuredRole`, `hubBaseUrl`, `proxyId`, `proxyCount`, `hostedWorkspaceCount`, `queueDepth`, `fanoutDepth`, `conflictCount`, and `staleReadStatus`. - `Standalone` serves local workspaces only. `DirectProxy` is the existing point-to-point proxy mode. `Hub` is authoritative for enrolled proxies and global workspace inventory. `LocalProxy` forwards MCP requests to `hubBaseUrl` and queues mutating requests during hub outages. - LocalProxy queued writes return `202 Accepted` with `X-Mcp-Queued: true` and `X-Mcp-Operation-Id`. Treat the write as optimistic until the hub acknowledges it. - If `queueDepth`, `fanoutDepth`, `conflictCount`, or stale-read status is non-zero/non-clear, include that in session log status and avoid claiming federation synchronization is complete.\n81: \n82: ## Per User Message\n83: 1. Post a new session log turn before starting work.\n84: 2. Complete the user's request.\n85: 3. Update the turn with results and actions when done.\n86: \n87: ## Re-run Full Session Start Only If\n88: - The user explicitly says \"Start Session\". - Signature verification fails. - /health fails. - /health nonce verification fails. - Any /mcpserver/* call returns 401. - The marker endpoint/key changes after a server restart.\n89: \n90: ## Continuing After a Server Restart\n91: The workspace API key rotates on every server restart, so an in-flight agent will begin seeing 401 on /mcpserver/* calls. When that happens, resume through your required agent plugin - do not hand-roll raw REST for session, TODO, or requirements work:\n92: 1. Treat the first 401 (or a /health failure) as a restart signal and stop using the cached API key immediately.\n93: 2. Re-read this marker file (AGENTS-README-FIRST.yaml) for the rotated apiKey and current endpoints.\n94: 3. Re-verify trust before resuming: recompute the marker signature with the new key and call /health with a fresh nonce.\n95: 4. Re-bootstrap and resume through your required agent plugin. Codex: run `Invoke-CodexMcpPlugin.ps1 -Command Status` to re-establish marker trust, health nonce, workspace, and the current session/turn, then continue with `Invoke-CodexMcpPlugin.ps1 -Command Invoke -Method <method> -Params <yaml>`. Other agents: re-run the plugin session-start hook/command, then continue via the plugin session tools.\n96: 5. Recover the open turn instead of starting over: query session history through the plugin (workflow.sessionlog.queryHistory), find the in-progress turn, then keep updating and complete it via the plugin. Do not open a duplicate session for the same work.\n97: 5a. Treat `deprecated: true` on successful `workflow.*` results as metadata, not wrapper failure. Treat an empty `workflow.sessionlog.queryHistory` result as a valid no-match result. Re-check the workspace current directory, explicit `agent` or `sourceType`, and plugin cache/session state through the wrapper; do not use raw REST merely because history is empty or marked deprecated.\n98: 6. If the plugin cannot re-establish trust after the restart, record `MCP_PLUGIN_UNAVAILABLE:<Agent>` and continue with non-MCP local diagnosis only.\n99: \n100: ## Rules\n101: 0. NEVER write to TODO.yaml directly.\n102: 1. Generate SessionId values using `session.init` (REPL) or `New-McpSessionLogSlug -Agent <SourceType> -Model <Model>` (PowerShell module), then create session logs with `session.new` (REPL) or `New-McpSessionLog -SessionId` (PowerShell). Do not handcraft SessionId values.\n103: 1a. Agents must identify themselves accurately in session logs. `sourceType` and the SessionId `<Agent>` prefix must use the agent's real identity in Pascal-Case. Do not use lowercase forms, placeholders, or legacy aliases.\n104: 2. Post a new session log turn (`session.turn.add` for REPL or `Add-McpSessionTurn` for PowerShell) before starting work. Update it with results (`Response`) and actions (`Add-McpAction` / `session.action.add`) when done. Persist after each meaningful update, not just at the end.\n105: 2a. Before any compaction step, persist the current session log state. After compaction, update the session log again to record the compaction outcome and recovered context.\n106: 3. If signature verification, the /health request, or nonce verification fails, log `MCP_UNTRUSTED`, continue without the MCP server, and do not probe additional MCP endpoints.\n107: 4. Marker signatures use HMAC-SHA256 with the workspace API key in this file as the verifier. Recompute the canonical payload exactly as described by the marker metadata before trusting the file.\n108: 5. Use your required agent plugin for session log, TODO, requirements, import/export, and traceability operations. Do not use raw API calls or generic helper paths except for read-only diagnosis after plugin failure.\n109: 6. Write decisions, requirements, and state to the session log, not just conversation. Capture rich turn detail: interpretation, response/status, actions (type/status/filePath), contextList, filesModified, designDecisions, requirementsDiscovered, blockers, and key processingDialog updates.\n110: 7. Follow workspace conventions in AGENTS.md and .github/copilot-instructions.md.\n111: 8. When you need API schemas, module examples, or compliance rules, load them from docs/context/ or use context_search.\n112: 9. Do not fabricate information. Acknowledge mistakes. Distinguish facts from speculation.\n113: 10. Prioritize correctness over speed. Do not ship code you have not verified compiles.\n114: \n115: 11. Use the Byrd Development Process V4 for all plans: organize work into small gated implementation slices, define validation before broadening scope, and keep session-log/TODO updates current between meaningful steps. A Byrd gate requires 100% test success before moving to the next iteration: zero failed tests and zero skipped tests in the executed validation scope. Tests are the progress ledger; do not hide unfinished work with skipped tests. Track deferred scope in MCP TODO/requirements and add its tests when that slice begins.\n116: \n117: ## Commit Signing\n118: ALL COMMITS MUST BE SIGNED WITH `model-effort@agent` and Model's Confidence in the Correctness, Accuracy, and Completeness of the commit's contents.\n119: \n120: ## Planning Standard\n121: Plans are frontier-model handoff artifacts. Write them so a less expensive implementation model can execute successfully without resolving unstated product, architecture, interface, data, testing, rollout, or validation decisions.\n122: Every plan must be decision-complete. Lock the intended behavior, public interfaces, data shapes, migration/backfill strategy, failure modes, rollout or deployment path, validation commands, and acceptance criteria before implementation starts.\n123: Every plan must capture requirements before implementation: create or update FR/TR/TEST records through the required MCP requirements workflow, include the requirement IDs in the TODO and session log, and map FR to TR and TEST coverage.\n124: Every implementation plan must name the TDD unit tests to add or update first, the expected red state, the green criteria, and the exact validation scope for each Byrd gate.\n125: \n126: ## Naming Conventions\n127: \n128: - Persisted TODO IDs must be uppercase canonical ids in either <SDLC-PHASE>-<AREA>-### form (regex: ^[A-Z]+-[A-Z0-9]+-\\d{3}$) or ISSUE-{number} form (regex: ^ISSUE-\\d+$).\n129: - Valid TODO IDs: PLAN-NAMINGCONVENTIONS-001, MCP-API-042, ISSUE-17.\n130: - Invalid TODO IDs: plan-api-001, MCP-API-42, ISSUE-ABC, MCPAPI001.\n131: - Create requests may use ISSUE-NEW only when the intent is to create a new GitHub-backed TODO. The server will create the GitHub issue immediately and persist the TODO using the canonical ISSUE-{number} id.\n132: - Session IDs must use <Agent>-<yyyyMMddTHHmmssZ>-<suffix> and start with the exact agent/source type prefix.\n133: - `<Agent>` / `sourceType` must be the agent's real identity in Pascal-Case. Valid example: `Codex`. Invalid examples: `codex`, `copilotcli` (when the agent is Codex), `Assistant`.\n134: - Valid Session ID: Copilot-20260304T113901Z-namingconv.\n135: - Invalid Session IDs: copilot-20260304T113901Z-namingconv, Copilot-2026-03-04-namingconv.\n136: - Request IDs must use req-<yyyyMMddTHHmmssZ>-<slugOrOrdinal> and be unique within a session.\n137: - Valid Request ID: req-20260304T113901Z-plan-namingconventions-001.\n138: - Invalid Request IDs: req-plan-namingconventions-001, request-20260304T113901Z-task-01.\n139: \n140: ## Workspace\n141: \n142: - Name: McpServer\n143: - Path: /home/sharpninja/github/McpServer\n144: - Primary: True\n145: - Data Directory: /home/sharpninja/github/McpServer\n146: - Todo Path: docs/Project/TODO.yaml\n147: \n148: \n149: ## Authentication\n150: \n151: All /mcpserver/* endpoints require a per-workspace auth token:\n152: - Header: X-Api-Key: [REDACTED:api-key]\n153: - Or query param: ?api_key=[REDACTED:api-key]\n154: If you receive a 401, re-read this marker file — the token rotates on each server restart.\n155: \n156: ## Where Things Live\n157: \n158: - AGENTS.md — agent conduct, requirements tracking, session continuity, glossary\n159: - .github/copilot-instructions.md — build/test commands, architecture, coding conventions\n160: - docs/context/ — on-demand reference (schemas, module docs, compliance rules, action types)\n161: - docs/Project/ — requirements docs, TODO.yaml, mapping matrices\n162: - templates/ — prompt templates\n163: \n164: ## Context Loading by Task Type\n165: \n166: - Session logging → docs/context/session-log-schema.md + docs/context/module-bootstrap.md (pull module-bootstrap via MCP context)\n167: - TODO management → docs/context/todo-schema.md + docs/context/module-bootstrap.md (pull module-bootstrap via MCP context)\n168: - API integration → docs/context/api-capabilities.md (or GET http://LAB-OMARCHY:7147/swagger/v1/swagger.json)\n169: - Adding dependencies → docs/context/compliance-rules.md\n170: - Logging actions → docs/context/action-types.md\n171: \n172: ## Protocols\n173: \n174: - REST API: http://LAB-OMARCHY:7147/mcpserver/* (requires X-Api-Key). Use this for typed client/API integration and read-only diagnosis after the required plugin/tool route fails. Do not bypass the required plugin for session log, TODO, requirements, import/export, or traceability operations. Swagger UI: http://LAB-OMARCHY:7147/swagger\n175: - MCP Streamable HTTP: POST http://LAB-OMARCHY:7147/mcp-transport (no API key required)\n176: - Health: GET http://LAB-OMARCHY:7147/health\n177: \n178: ## Repository Access\n179: \n180: - Hosted agents expose built-in repository tools: `mcp_repo_list`, `mcp_repo_read`, and `mcp_repo_write`.\n181: - All repository paths are relative to /home/sharpninja/github/McpServer.\n182: - REST clients can browse and edit files through http://LAB-OMARCHY:7147/mcpserver/repo/list and http://LAB-OMARCHY:7147/mcpserver/repo/file using the API key above.\n183: - If you need to browse or edit files, use these repository tools instead of saying that filesystem access is unavailable.\n184: ## Local Program Execution\n185: \n186: - Hosted agents expose a built-in local program execution tool: `mcp_desktop_launch`.\n187: - Use it when you need to start a local Windows program through MCP Server instead of claiming local program execution is unavailable.\n188: - Prefer `createNoWindow: true` and `waitForExit: true` for short non-interactive verification commands.\n189: - REST clients can launch programs through http://LAB-OMARCHY:7147/mcpserver/desktop/launch using 