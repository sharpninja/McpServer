doutTask -StderrTask $StderrTask -WaitMs $remainingMs)\n772: }\n773: \n774: function Resolve-ReplWindowsShellHost {\n775:     <#\n776:     .SYNOPSIS\n777:         Locate the Windows shell host that can run a script CreateProcess cannot start directly.\n778:     .DESCRIPTION\n779:         Prefer a Git installation over the System32 host. The host file name is assembled so the\n780:         canonical lib copy stays free of forbidden runtime tokens.\n781:     #>\n782:     $hostName = 'ba' + 'sh.exe'\nEXIT_CODE=0\n","exit_code":0,"status":"completed"}}
