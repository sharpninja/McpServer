zed[0]\\n 96 |         $last = $normalized[$normalized.Length - 1]\\n 97 |         if (($first -eq '\\\"' -and $last -eq '\\\"') -or ($first -eq \\\"'\\\" -and $last -eq \\\"'\\\")) {\\n 98 |             return $normalized.Substring(1, $normalized.Length - 2)\\n 99 |         }\\n100 |     }\\n101 | \\n102 |     return $normalized\\n103 | }\\n104 | \\n105 | function ConvertFrom-McpMarkerContent {\\n106 |     param(\\n107 |         [Parameter(Mandatory)][string]$Content\\n108 |     )\\n109 | \\n110 |     $normalized = $Content.ReplaceLineEndings(\\\"`n\\\")\\n111 |     $lines = $normalized -split \\\"`n\\\"\\n112 |     $marker = [ordered]@{\\n113 |         endpoints = [ordered]@{}\\n114 |         signature = [ordered]@{}\\n115 |         trust_bootstrap = [ordered]@{}\\n116 |         prompt = ''\\n117 |     }\\n118 | \\n119 |     for ($index = 0; $index -lt $lines.Count; $index++) {\\n120 |         $line = $lines[$index]\\n121 |         if ([string]::IsNullOrWhiteSpace($line)) {\\n122 |             continue\\n123 |         }\\n124 | \\n125 |         if ($line -match '^(?<key>[A-Za-z_][A-Za-z0-9_]*)\\\\s*:\\\\s*(?<value>.*)$') {\\n126 |             $key = $Matches.key\\n127 |             $value = $Matches.value\\n128 | \\n129 |             if ($value -in @('|', '|-')) {\\n130 |                 $index++\\n131 |                 $promptLines = [System.Collections.Generic.List[string]]::new()\\n132 |                 while ($index -lt $lines.Count) {\\n133 |                     $promptLine = $lines[$index]\\n134 |                     if ($promptLine -match '^\\\\S') {\\n135 |                         $index--\\n136 |                         break\\n137 |                     }\\n138 | \\n139 |                     if ($promptLine.StartsWith('  ')) {\\n140 |                         [void]$promptLines.Add($promptLine.Substring(2))\\n141 |                     } else {\\n142 |                         [void]$promptLines.Add($promptLine)\\n143 |                     }\\n144 | \\n145 |