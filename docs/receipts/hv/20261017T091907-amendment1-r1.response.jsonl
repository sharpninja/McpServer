}\n267: \n268: function Get-McpFailsafeWorkspaceKey {\n269:     <#\n270:     .SYNOPSIS\n271:         Workspace key matching FilesystemSessionLogPersistenceStrategy (base64url of UTF-8 full path).\n272:     #>\n273:     [CmdletBinding()]\n274:     param([Parameter(Mandatory)][string]$WorkspacePath)\n275: \n276:     $full = [System.IO.Path]::GetFullPath($WorkspacePath)\n277:     $bytes = [System.Text.Encoding]::UTF8.GetBytes($full)\n278:     $b64 = [Convert]::ToBase64String($bytes)\n279:     return (($b64 -replace '\\+', '-') -replace '/', '_').TrimEnd('=')\n280: }\n281: \n282: function Resolve-McpFailsafeWorkspacePath {\n283:     <#\n284:     .SYNOPSIS\n285:         Resolves the workspace root used for the V4 failsafe tree.\n286:     #>\n287:     [CmdletBinding()]\n288:     param([string]$StartPath)\n289: \n290:     if (-not [string]::IsNullOrWhiteSpace($StartPath) -and (Test-Path -LiteralPath $StartPath -PathType Container)) {\n291:         return [System.IO.Path]::GetFullPath($StartPath)\n292:     }\n293: \n294:     $configured = Get-McpWorkspaceFromEnvironment\n295:     if ($configured) { return $configured }\n296: \n297:     if (Get-Command Find-MarkerFile -ErrorAction SilentlyContinue) {\n298:         $startCandidates = if (-not [string]::IsNullOrWhiteSpace($StartPath)) { @($StartPath) } else {\n299:             @(\n300:                 $env:MCP_WORKSPACE_START_DIR,\n301:                 $env:MCP_WORKSPACE_PATH,\n302:                 $env:MCPSERVER_WORKSPACE_PATH,\n303:                 (Get-Location).Path\n304:             ) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique\n305:         }\n306:         foreach ($startDir in $startCandidates) {\n307:             try {\n308:                 $markerFile = Find-MarkerFile -StartDir $startDir\n309:                 if ($markerFile) {\n310:                     return [System.IO.Path]::GetFullPath((Split-Path -Parent $markerFile))\n311:                 }\n312:             } catch {\n313: 