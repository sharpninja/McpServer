  "Source": [
    "#Requires -Version 7.0",
    "# Runs on PAYTON-LEGION2 as kingd over SSH (MEMORY-INFRA-001). Amendment H1 (TR-MCP-NUKE-019 AC-5): the",
    "# Windows integration lane runs from a console in kingd's interactive desktop session. This script prepares",
    "# a fresh worktree at the expected commit, writes a runner that records proof of the interactive session and",
    "# runs the Nuke target, and starts that runner once through a one-shot task that runs only in kingd's",
    "# logged-on desktop session (Interactive logon type, limited rights). It changes no tracked file and no",
    "# setting; Get-WinInteractiveLane.ps1 reads the result and removes the task.",
    "$ErrorActionPreference = 'Stop'",
    "$ExpectedSha = 'b4ad42aaa601ed0df7e03b34203dee4f93d316a9'",
    "$RunId = 'unit-green-win-interactive-20261019T2112'",
    "$TaskName = 'McpServer-UnitGreenInteractiveLane-20261019T2112'",
    "$Repo = 'F:/GitHub/McpServer'",
    "$Worktree = \"$Repo/.worktrees/unit-green-interactive-20261019\"",
    "$Ref = 'origin/fix/unit-suite-green-20261019'",
    "$Work = Join-Path $env:TEMP 'unit-green-interactive'",
    "$env:GIT_CONFIG_COUNT = '1'",
    "$env:GIT_CONFIG_KEY_0 = 'safe.directory'",
    "$env:GIT_CONFIG_VALUE_0 = '*'",
    "",
    "\"START $((Get-Date).ToString('s')) host=$env:COMPUTERNAME user=$env:USERNAME\"",
    "if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) { \"STOP: task $TaskName already exists\"; return }",
    "$null = New-Item -ItemType Directory -Force -Path $Work",
    "git -C $Repo fetch origin 2>&1 | ForEach-Object { \"  fetch: $_\" }",
    "$refSha = (git -C $Repo rev-parse $Ref).Trim()",
    "if ($refSha -ne $ExpectedSha) { \"STOP: $Ref is $refSha, expected $ExpectedSha\"; return }",
    "if (-not (Test-Path -LiteralPath $Worktree)) {",
    "    git -C $Repo worktree add --detach $Worktree $ExpectedSha 2>&1 | ForEach-Object { \"  worktree: $_\" }",
    "}",
    "else {",
    "    $changed = @(git -C $Worktree status --porcelain=v1 --untracked-files=no)",
    "    $generated = @($changed | Where-Object { $_.Substring(3) -eq '.nuke/build.schema.json' -or $_.Substring(3) -like 'docs/benchmarks/results/*' })",
    "    if ($changed.Count -ne $generated.Count) { \"STOP: tracked changes in $Worktree outside the generated allowlist: $($changed -join '; ')\"; return }",
    "    foreach ($line in $generated) { git -C $Worktree restore --worktree -- $line.Substring(3) }",
    "    git -C $Worktree checkout --detach $ExpectedSha 2>&1 | ForEach-Object { \"  checkout: $_\" }",
    "}",
    "$head = (git -C $Worktree rev-parse HEAD).Trim()",
    "\"HEAD $head expected=$ExpectedSha match=$($head -eq $ExpectedSha)\"",
    "if ($head -ne $ExpectedSha) { 'STOP: HEAD mismatch'; return }",
    "",
    "$runner = Join-Path $Work \"run-$RunId.ps1\"",
    "$log = Join-Path $Work \"MigrationIntegrationTests-$RunId.log\"",
    "$proof = Join-Path $Work \"proof-$RunId.txt\"",
    "$exitFile = Join-Path $Work \"exit-$RunId.txt\"",
    "foreach ($stale in @($log, $proof, $exitFile)) { if (Test-Path -LiteralPath $stale) { \"STOP: $stale already exists\"; return } }",
    "$runnerText = @(",
    "    '$ErrorActionPreference = ''Continue'''",
    "    ('$env:GIT_CONFIG_COUNT = ''1''; $env:GIT_CONFIG_KEY_0 = ''safe.directory''; $env:GIT_CONFIG_VALUE_0 = ''*''')",
    "    ('Set-Location -LiteralPath ''{0}''' -f $Worktree)",
    "    ('\"START $((Get-Date).ToString(''s'')) user=$env:USERNAME session=$((Get-Process -Id $PID).SessionId) interactive=$([Environment]::UserInteractive) head=$((git rev-parse HEAD).Trim())\" | Set-Content -LiteralPath ''{0}''' -f $proof)",
    "    ('& ./build.ps1 MigrationIntegrationTests --test-run-id ''{0}'' *> ''{1}''' -f $RunId, $log)",
    "    ('Set-Content -LiteralPath ''{0}'' -Value ([string]$LASTEXITCODE + '' '' + (Get-Date).ToString(''s''))' -f $exitFile)",
    ") -join [Environment]::NewLine",
    "Set-Content -LiteralPath $runner -Value $runnerText -Encoding utf8",
    "\"RUNNER $runner\"",
    "",
    "# The pwsh on kingd's PATH is the Store app-execution alias, which the task scheduler may not resolve;",
    "# a regular installation under Program Files is used when present.",
    "$pwsh = @(Get-ChildItem -Path 'C:/Program Files/PowerShell/*/pwsh.exe' -ErrorAction SilentlyContinue | Sort-Object FullName | Select-Object -ExpandProperty FullName -First 1)",
    "$pwsh = if ($pwsh.Count -gt 0) { $pwsh[0] } else { (Get-Command pwsh -ErrorAction Stop).Source }",
    "\"PWSH $pwsh\"",
    "$action = New-ScheduledTaskAction -Execute $pwsh -Argument ('-NoProfile -ExecutionPolicy Bypass -File \"{0}\"' -f $runner) -WorkingDirectory $Worktree.Replace('/', '\\')",
    "# In an SSH session USERDOMAIN does not name the local machine; the token's own account name does.",
    "$account = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name",
    "\"ACCOUNT $account\"",
    "$principal = New-ScheduledTaskPrincipal -UserId $account -LogonType Interactive -RunLevel Limited",
    "$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero)",
    "$null = Register-ScheduledTask -TaskName $TaskName -Action $action -Principal $principal -Settings $settings -Description 'One-shot IMPL-UNITGREEN-001 interactive lane run (removed after it ends)'",
    "Start-ScheduledTask -TaskName $TaskName",
    "Start-Sleep -Seconds 5",
    "$info = Get-ScheduledTaskInfo -TaskName $TaskName",
    "\"TASK $TaskName state=$((Get-ScheduledTask -TaskName $TaskName).State) lastRun=$($info.LastRunTime) result=$($info.LastTaskResult)\"",
    "\"PROOF so far: $(if (Test-Path -LiteralPath $proof) { (Get-Content -LiteralPath $proof -Raw).Trim() } else { '(not written yet)' })\"",
    "\"END $((Get-Date).ToString('s'))\""
  ]
}
