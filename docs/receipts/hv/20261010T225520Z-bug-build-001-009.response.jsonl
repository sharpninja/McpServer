{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/usr/bin/pwsh -Command \"pwsh.exe -NoProfile -NonInteractive -Command 'Get-Content tests/Build.Tests/NukeParametersTests.cs; Get-Content Directory.Build.props | Select-Object -First 60; git diff --check a90e8b4c\"'^ HEAD'\"'\"","aggregated_output":"// SPDX-License-Identifier: Apache-2.0\nusing System.Text.Json;\n\nnamespace NukeBuild.Tests;\n\n/// <summary>\n/// TR-MCP-NUKE-002 AC-001 (BUG-BUILD-001): verifies that the solution named by the checked-in <c>.nuke/parameters.json</c>\n/// exists at the repository root, so Nuke can inject <c>Build.Solution</c> and the Restore target, and every target that\n/// depends on it, can run. Build-infrastructure test, accountable through TR only. Reads the repository's own\n/// <c>.nuke/parameters.json</c>; no fixtures or mocks.\n/// </summary>\npublic sealed class NukeParametersTests\n{\n    /// <summary>\n    /// The <c>Solution</c> value in <c>.nuke/parameters.json</c> names a solution file that exists at the repository root\n    /// (TR-MCP-NUKE-002 AC-001; BUG-BUILD-001: the QBrainAi rename left it pointing at the removed <c>McpServer.sln</c>, so\n    /// Restore threw a NullReferenceException).\n    /// </summary>\n    [Fact]\n    public void NukeParameters_Solution_NamesExistingSolutionFile()\n    {\n        var root = FindRepositoryRoot();\n        using var parameters = JsonDocument.Parse(File.ReadAllText(Path.Combine(root, \".nuke\", \"parameters.json\")));\n        var solution = parameters.RootElement.GetProperty(\"Solution\").GetString();\n\n        Assert.False(string.IsNullOrWhiteSpace(solution), \".nuke/parameters.json has no Solution value.\");\n        Assert.True(\n            File.Exists(Path.Combine(root, solution!)),\n            $\".nuke/parameters.json names Solution '{solution}', which does not exist at the repository root {root}.\");\n    }\n\n    /// <summary>Finds the repository root by the <c>.nuke/parameters.json</c> file, independent of the solution name under test.</summary>\n    private static string FindRepositoryRoot()\n    {\n        var directory = new DirectoryInfo(AppContext.BaseDirectory);\n        while (directory is not null)\n        {\n            if (File.Exists(Path.Combine(directory.FullName, \".nuke\", \"parameters.json\")))\n                return directory.FullName;\n            directory = directory.Parent;\n        }\n\n        throw new InvalidOperationException(\".nuke/parameters.json not found above \" + AppContext.BaseDirectory);\n    }\n}\n<Project>\n  <PropertyGroup>\n    <Configuration Condition=\"'$(Configuration)' == ''\">Debug</Configuration>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <Nullable>enable</Nullable>\n    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>\n    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>\n    <GenerateDocumentationFile>true</GenerateDocumentationFile>\n  </PropertyGroup>\n\n  <PropertyGroup Condition=\"$(MSBuildProjectName.EndsWith('.Tests')) OR $(MSBuildProjectName.EndsWith('.IntegrationTests')) OR '$(MSBuildProjectName)' == '_build'\">\n    <GenerateDocumentationFile>false</GenerateDocumentationFile>\n  </PropertyGroup>\n\n  <PropertyGroup Condition=\"'$(IsTestProject)' == 'true' OR $(MSBuildProjectName.EndsWith('.Tests'))\">\n    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>\n  </PropertyGroup>\n</Project>\ndocs/receipts/_bug-build-003-009-20261010T224959Z/g1-compile.log.txt:48: trailing whitespace.\n+17:51:43 [DBG] \ndocs/receipts/_bug-build-003-009-20261010T224959Z/g1-compile.log.txt:52: trailing whitespace.\n+17:51:43 [DBG] \ndocs/receipts/_bug-build-003-009-20261010T224959Z/g1-compile.log.txt:58: trailing whitespace.\n+17:51:45 [DBG] \ndocs/receipts/_bug-build-003-009-20261010T224959Z/g1-compile.log.txt:62: trailing whitespace.\n+17:51:45 [DBG] \ndocs/receipts/_bug-build-003-009-20261010T224959Z/g1-compile.log.txt:67: trailing whitespace.\n+17:51: