{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/pwsh -Command \"pwsh.exe -NoProfile -NonInteractive -Command 'Get-Content tests/Build.Tests/BoundedProcess.cs | ForEach-Object -Begin {\"'$i=0} -Process { $i++; \"${i}:$_\" }; Get-Content tests/Build.Tests/BoundedProcessTests.cs | ForEach-Object -Begin {$i=0} -Process { $i++; \"${i}:$_\" }'\"'\"","aggregated_output":"1:// SPDX-License-Identifier: Apache-2.0\n2:using System.Diagnostics;\n3:using System.Text;\n4:\n5:namespace NukeBuild.Tests;\n6:\n7:/// <summary>\n8:/// TR-MCP-NUKE-009 (BUG-BUILD-007): the one way the Build.Tests infrastructure suite runs a child process with redirected output.\n9:/// It bounds the wait for the child to exit and, once the child has exited, the wait for its output to close; drains standard\n10:/// output and standard error concurrently; kills the child's process tree on timeout or cancellation; and starts dotnet children\n11:/// with <c>--disable-build-servers</c>. Without these bounds a descendant that inherits the child's pipes, such as an MSBuild worker\n12:/// node started with node reuse, holds them open after the child exits, and the suite waits for an end of stream that never comes.\n13:/// </summary>\n14:internal static class BoundedProcess\n15:{\n16:    private const int CapturedTailLength = 4000;\n17:\n18:    /// <summary>TR-MCP-NUKE-009 AC-001: how long to wait for redirected output to close after the child exits.</summary>\n19:    internal static readonly TimeSpan DefaultDrainTimeout = TimeSpan.FromSeconds(30);\n20:\n21:    /// <summary>\n22:    /// TR-MCP-NUKE-009 AC-005: a <c>dotnet</c> start info for <paramref name=\"arguments\"/> that ignores persistent build servers, so\n23:    /// no MSBuild worker node, MSBuild server, or compiler server outlives the child holding its redirected output.\n24:    /// </summary>\n25:    internal static ProcessStartInfo Dotnet(string workingDirectory, IEnumerable<string> arguments)\n26:    {\n27:        var startInfo = new ProcessStartInfo(\"dotnet\") { WorkingDirectory = workingDirectory };\n28:        foreach (var argument in arguments)\n29:        {\n30:            startInfo.ArgumentList.Add(argument);\n31:        }\n32:\n33:        startInfo.ArgumentList.Add(\"--disable-build-servers\");\n34:        return startInfo;\n35:    }\n36:\n37:    /// <summary>Synchronous <see cref=\"RunAsync(ProcessStartInfo, TimeSpan, CancellationToken)\"/> for synchronous fixtures.</summary>\n38:    internal static BoundedProcessResult Run(ProcessStartInfo startInfo, TimeSpan exitTimeout, CancellationToken cancellationToken) =>\n39:        RunAsync(startInfo, exitTimeout, DefaultDrainTimeout, cancellationToken).GetAwaiter().GetResult();\n40:\n41:    /// <summary>Runs the child with the default drain period, <see cref=\"DefaultDrainTimeout\"/>.</summary>\n42:    internal static Task<BoundedProcessResult> RunAsync(ProcessStartInfo startInfo, TimeSpan exitTimeout, CancellationToken cancellationToken) =>\n43:        RunAsync(startInfo, exitTimeout, DefaultDrainTimeout, cancellationToken);\n44:\n45:    /// <summary>\n46:    /// TR-MCP-NUKE-009 AC-001..AC-004: starts the child with redirected output, drains standard output and standard error\n47:    /// concurrently, and returns the exit code with the complete output.\n48:    /// </summary>\n49:    /// <exception cref=\"TimeoutException\">The child ran past <paramref name=\"exitTimeout\"/>; its process tree was killed.</exception>\n50:    /// <exception cref=\"OperationCanceledException\">The caller cancelled; a still-running child's process tree was killed.</exception>\n51:    /// <exception cref=\"IOException\">The child exited, but its output was still open <paramref name=\"drainTimeout\"/> later.</exception>\n52:    internal static async Task<BoundedProcessResult> RunAsync(\n53:        ProcessStartInfo startInfo,\n54:        TimeSpan exitTimeout,\n55:        TimeSpan drainTimeout,\n56:        CancellationToken cancellationToken)\n57:    {\n58:        ArgumentNullException.ThrowIfNull(startInfo);\n59:        startInfo.UseShellExecute = false;\n60:        startInfo.RedirectStandardOutput = true;\n61:        startInfo.RedirectStandardError = true;\n62:        var command = Describe(startInfo);\n63:        var stdout = new StringBuilder();\n64:        var stderr = new StringBuilder();\n65:        using var abandon = new CancellationTokenSource();\n66:        using var process = Process.Start(startInfo) ?? throw new InvalidOperationException($\"Failed to start {command}.\");\n67:        var output = Task.WhenAll(\n68:            PumpAsync(process.StandardOutput, stdout, abandon.Token),\n69:            PumpAsync(process.StandardError, stderr, abandon.Token));\n70:\n71:        using (var exit = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken))\n72:        {\n73:            exit.CancelAfter(exitTimeout);\n74:            try\n75:            {\n76:                await process.WaitForExitAsync(exit.Token).ConfigureAwait(false);\n77:            }\n78:            catch (OperationCanceledException)\n79:            {\n80:                await KillTreeAsync(process).ConfigureAwait(false);\n81:                await abandon.CancelAsync().ConfigureAwait(false);\n82:                cancellationToken.ThrowIfCancellationRequested();\n83:                throw new TimeoutException(\n84:                    $\"{command} did not exit within {exitTimeout}; its process tree was killed.{Captured(stdout, stderr)}\");\n85:            }\n86:        }\n87:\n88:        // AC-001: the child has exited, but its output closes only when every holder of the pipes' write ends has closed them.\n89:        try\n90:        {\n91:            await output.WaitAsync(drainTimeout, cancellationToken).ConfigureAwait(false);\n92:        }\n93:        catch (TimeoutException)\n94:        {\n95:            await abandon.CancelAsync().ConfigureAwait(false);\n96:            throw new IOException(\n97:                $\"{command} exited with code {process.ExitCode}, but its redirected output was still open {drainTimeout} later: a \"\n98:                + $\"descendant process inherited the pipes, so the captured output may be incomplete.{Captured(stdout, stderr)}\");\n99:        }\n100:        catch (OperationCanceledException)\n101:        {\n102:            await abandon.CancelAsync().ConfigureAwait(false);\n103:            throw;\n104:        }\n105:\n106:        return new BoundedProcessResult(process.ExitCode, Snapshot(stdout), Snapshot(stderr));\n107:    }\n108:\n109:    /// <summary>\n110:    /// Copies one redirected stream into <paramref name=\"sink\"/> until it closes. A read blocked on a pipe that a descendant holds\n111:    /// open cannot be interrupted, so an abandoned pump simply finishes whenever the last writer closes the pipe.\n112:    /// </summary>\n113:    private static async Task PumpAsync(StreamReader reader, StringBuilder sink, CancellationToken abandoned)\n114:    {\n115:        var buffer = new char[4096];\n116:        try\n117:        {\n118:            int read;\n119:            while ((read = await reader.ReadAsync(buffer.AsMemory(), abandoned).ConfigureAwait(false)) > 0)\n120:            {\n121:                lock (sink)\n122:                {\n123:                    sink.Append(buffer, 0, read);\n124:                }\n125:            }\n126:        }\n127:        catch (Exception exception) when (abandoned.IsCancellationRequested\n128:            && exception is OperationCanceledException or ObjectDisposedException or IOException)\n129:        {\n130:            // Abandoned after a timeout, a cancellation, or output held open; what was read is already in the sink.\n131:        }\n132:    }\n133:\n134:    /// <summary>TR-MCP-NUKE-009 AC-002, AC-003: kills the child and its descendants, then waits briefly for the kill to land.</summary>\n135:    private static async Task KillTreeAsync(Process process)\n136:    {\n137:        try\n138:        {\n139:            process.Kill(entireProcessTree: true);\n140:        }\n141:        catch (InvalidOperationException)\n142:        {\n143:            // The child exited between the timeout and the kill.\n144:        }\n145:\n146:        using var reaped = new CancellationTokenSource(TimeSpan.FromSeconds(10));\n147:        try\n148:        {\n149:            await process.WaitForExitAsync(reaped.Token).ConfigureAwait(false);\n150:        }\n151:        catch (OperationCanceledException)\n152:        {\n153:            // Killed but not yet reaped; the caller still gets the timeout or the cancellation.\n154:        }\n155:    }\n156:\n157:    private static string Describe(ProcessStartInfo startInfo)\n158:    {\n159:        if (startInfo.ArgumentList.Count > 0)\n160:        {\n161:            return $\"{startInfo.FileName} {string.Join(' ', startInfo.ArgumentList)}\";\n162:        }\n163:\n164:        return string.IsNullOrEmpty(startInfo.Arguments) ? startInfo.FileName : $\"{startInfo.FileName} {startInfo.Arguments}\";\n165:    }\n166:\n167:    private static string Snapshot(StringBuilder sink)\n168:    {\n169:        lock (sink)\n170:        {\n171:            return sink.ToString();\n172:        }\n173:    }\n174:\n175:    private static string Captured(StringBuilder stdout, StringBuilder stderr) =>\n176:        $\"{Environment.NewLine}stdout:{Environment.NewLine}{Tail(Snapshot(stdout))}\"\n177:        + $\"{Environment.NewLine}stderr:{Environment.NewLine}{Tail(Snapshot(stderr))}\";\n178:\n179:    private static string Tail(string text) => text.Length <= CapturedTailLength ? text : \"...\" + text[^CapturedTailLength..];\n180:}\n181:\n182:/// <summary>TR-MCP-NUKE-009: a finished child's exit code and its complete redirected output.</summary>\n183:/// <param name=\"ExitCode\">The child's exit code.</param>\n184:/// <param name=\"Stdout\">Everything the child wrote to standard output.</param>\n185:/// <param name=\"Stderr\">Everything the child wrote to standard error.</param>\n186:internal sealed record BoundedProcessResult(int ExitCode, string Stdout, string Stderr);\n1:// SPDX-License-Identifier: Apache-2.0\n2:using System.Diagnostics;\n3:\n4:namespace NukeBuild.Tests;\n5:\n6:/// <summary>\n7:/// TR-MCP-NUKE-009 (BUG-BUILD-007): verifies <see cref=\"BoundedProcess\"/>, the one way Build.Tests runs a child process with\n8:/// redirected output. Build-infrastructure test, accountable through TR only. The process cases start real <c>pwsh</c> children\n9:/// (no mocks); each writes the process id it must clean up to a temporary file that the test removes.\n10:/// </summary>\n11:public sealed class BoundedProcessTests\n12:{\n13:    /// <summary>\n14:    /// TR-MCP-NUKE-009 AC-001: a child that exits while a descendant still holds its redirected output makes RunAsync fail within\n15:    /// the drain period, naming the command and keeping what the child wrote, instead of waiting for the descendant. The pwsh child\n16:    /// starts a second pwsh with <c>Start-Process -NoNewWindow</c>, which inherits the child's stdout and stderr as an MSBuild worker\n17:    /// node started with node reuse does (the BUG-BUILD-007 root cause), records its process id, and exits; the descendant sleeps 30 s.\n18:    /// </summary>\n19:    [Fact]\n20:    public async Task RunAsync_DescendantHoldsOutputAfterChildExits_FailsWithinDrainPeriod()\n21:    {\n22:        var pidFile = NewPidFile();\n23:        var command = \"$descendant = Start-Process -FilePath (Get-Process -Id $PID).Path -ArgumentList '-NoLogo','-NoProfile',\"\n24:            + \"'-NonInteractive','-Command','Start-Sleep -Seconds 30' -NoNewWindow -PassThru; \"\n25:            + $\"Set-Content -LiteralPath '{pidFile}' -Value $descendant.Id; 'child-exited'\";\n26:        var stopwatch = Stopwatch.StartNew();\n27:        try\n28:        {\n29:            var exception = await Assert.ThrowsAsync<IOException>(() => BoundedProcess.RunAsync(\n30:                Pwsh(command), TimeSpan.FromMinutes(1), TimeSpan.FromSeconds(2), TestContext.Current.CancellationToken));\n31:\n32:            Assert.True(stopwatch.Elapsed < TimeSpan.FromSeconds(20), $\"RunAsync waited {stopwatch.Elapsed} for the descendant.\");\n33:            Assert.Contains(\"pwsh\", exception.Message, StringComparison.Ordinal);\n34:            Assert.Contains(\"child-exited\", exception.Message, StringComparison.Ordinal);\n35:        }\n36:        finally\n37:        {\n38:            KillRecorded(pidFile);\n39:        }\n40:    }\n41:\n42:    /// <summary>\n43:    /// TR-MCP-NUKE-009 AC-002: a child that runs past its exit timeout is killed with its process tree and RunAsync throws a\n44:    /// <see cref=\"TimeoutException\"/> naming the command. The pwsh child records its own process id and sleeps 60 s; the exit\n45:    /// timeout is 10 s.\n46:    /// </summary>\n47:    [Fact]\n48:    public async Task RunAsync_ChildRunsPastExitTimeout_KillsTreeAndThrowsTimeout()\n49:    {\n50:        var pidFile = NewPidFile();\n51:        var command = $\"Set-Content -LiteralPath '{pidFile}' -Value $PID; Start-Sleep -Seconds 60\";\n52:        var stopwatch = Stopwatch.StartNew();\n53:        try\n54:        {\n55:            var exception = await Assert.ThrowsAsync<TimeoutException>(() => BoundedProcess.RunAsync(\n56:                Pwsh(command), TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(2), TestContext.Current.CancellationToken));\n57:\n58:            Assert.True(stopwatch.Elapsed < TimeSpan.FromSeconds(40), $\"RunAsync returned after {stopwatch.Elapsed}.\");\n59:            Assert.Contains(\"pwsh\", exception.Message, StringComparison.Ordinal);\n60:            Assert.True(HasExited(pidFile), \"The child outlived its exit timeout.\");\n61:        }\n62:        finally\n63:        {\n64:            KillRecorded(pidFile);\n65:        }\n66:    }\n67:\n68:    /// <summary>\n69:    /// TR-MCP-NUKE-009 AC-003: when the caller cancels, RunAsync kills the child's process tree and stops waiting. The pwsh child\n70:    /// records its own process id and sleeps 60 s; the caller cancels after 10 s.\n71:    /// </summary>\n72:    [Fact]\n73:    public async Task RunAsync_CallerCancels_KillsTreeAndStopsWaiting()\n74:    {\n75:        var pidFile = NewPidFile();\n76:        var command = $\"Set-Content -LiteralPath '{pidFile}' -Value $PID; Start-Sleep -Seconds 60\";\n77:        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(TestContext.Current.CancellationToken);\n78:        cancellation.CancelAfter(TimeSpan.FromSeconds(10));\n79:        var stopwatch = Stopwatch.StartNew();\n80:        try\n81:        {\n82:            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => BoundedProcess.RunAsync(\n83:                Pwsh(command), TimeSpan.FromMinutes(2), TimeSpan.FromSeconds(2), cancellation.Token));\n84:\n85:            Assert.True(stopwatch.Elapsed < TimeSpan.FromSeconds(40), $\"RunAsync returned after {stopwatch.Elapsed}.\");\n86:            Assert.True(HasExited(pidFile), \"The child outlived the cancellation.\");\n87:        }\n88:        finally\n89:        {\n90:            KillRecorded(pidFile);\n91:        }\n92:    }\n93:\n94:    /// <summary>\n95:    /// TR-MCP-NUKE-009 AC-004: RunAsync drains standard output and standard error concurrently, so a child that writes 1 MiB to\n96:    /// standard error (more than any pipe buffer holds) before writing to standard output completes. A reader that drains standard\n97:    /// output to the end first would leave the child blocked on the full standard error pipe.\n98:    /// </summary>\n99:    [Fact]\n100:    public async Task RunAsync_ChildFillsStandardErrorBeforeWritingOutput_Completes()\n101:    {\n102:        var result = await BoundedProcess.RunAsync(\n103:            Pwsh(\"[Console]::Error.Write([string]::new([char]'e', 1048576)); [Console]::Out.Write('done')\"),\n104:            TimeSpan.FromMinutes(1),\n105:            TimeSpan.FromSeconds(10),\n106:            TestContext.Current.CancellationToken);\n107:\n108:        Assert.Equal(0, result.ExitCode);\n109:        Assert.Equal(\"done\", result.Stdout.Trim());\n110:        Assert.Equal(1048576, result.Stderr.Count(character => character == 'e'));\n111:    }\n112:\n113:    /// <summary>\n114:    /// TR-MCP-NUKE-009 AC-005: dotnet children ignore persistent build servers, so no MSBuild worker node, MSBuild server, or\n115:    /// compiler server outlives the child holding its redirected output. Pure start-info construction; no process starts.\n116:    /// </summary>\n117:    [Fact]\n118:    public void Dotnet_AppendsDisableBuildServers()\n119:    {\n120:        var startInfo = BoundedProcess.Dotnet(\"repo-root\", [\"build\", \"project.csproj\", \"-c\", \"Debug\"]);\n121:\n122:        string[] expected = [\"build\", \"project.csproj\", \"-c\", \"Debug\", \"--disable-build-servers\"];\n123:        Assert.Equal(\"dotnet\", startInfo.FileName);\n124:        Assert.Equal(\"repo-root\", startInfo.WorkingDirectory);\n125:        Assert.Equal(expected, startInfo.ArgumentList);\n126:    }\n127:\n128:    /// <summary>\n129:    /// TR-MCP-NUKE-009 AC-006: no Build.Tests source other than <see cref=\"BoundedProcess\"/> reads a child's redirected output or\n130:    /// waits for a child to exit, so every child process the suite starts is bounded. Scans the C# sources under tests/Build.Tests\n131:    /// (build output excluded) for direct output reads and exit waits.\n132:    /// </summary>\n133:    [Fact]\n134:    public void BuildTestsSources_ReadChildOutputOnlyThroughBoundedProcess()\n135:    {\n136:        var directory = Path.Combine(FindRepositoryRoot(), \"tests\", \"Build.Tests\");\n137:        string[] patterns = [\".StandardOutput\", \".StandardError\", \"WaitForExit\", \"BeginOutputReadLine\", \"BeginErrorReadLine\"];\n138:        string[] owners = [\"BoundedProcess.cs\", \"BoundedProcessTests.cs\"];\n139:        var offendingLines = Directory.EnumerateFiles(directory, \"*.cs\", SearchOption.AllDirectories)\n140:            .Where(path => !IsBuildOutput(Path.GetRelativePath(directory, path)))\n141:            .Where(path => !owners.Contains(Path.GetFileName(path), StringComparer.Ordinal))\n142:            .SelectMany(path => File.ReadLines(path).Select((line, index) => new { Path = path, Line = line, LineNumber = index + 1 }))\n143:            .Where(entry => patterns.Any(pattern => entry.Line.Contains(pattern, StringComparison.Ordinal)))\n144:            .Select(entry => $\"{Path.GetRelativePath(directory, entry.Path)}:{entry.LineNumber}: {entry.Line.Trim()}\")\n145:            .ToArray();\n146:\n147:        Assert.True(\n148:            offendingLines.Length == 0,\n149:            \"Read child output and wait for children only through BoundedProcess (TR-MCP-NUKE-009 AC-006):\"\n150:                + Environment.NewLine\n151:                + string.Join(Environment.NewLine, offendingLines));\n152:    }\n153:\n154:    private static ProcessStartInfo Pwsh(string command)\n155:    {\n156:        var startInfo = new ProcessStartInfo(\"pwsh\");\n157:        startInfo.ArgumentList.Add(\"-NoLogo\");\n158:        startInfo.ArgumentList.Add(\"-NoProfile\");\n159:        startInfo.ArgumentList.Add(\"-NonInteractive\");\n160:        startInfo.ArgumentList.Add(\"-Command\");\n161:        startInfo.ArgumentList.Add(command);\n162:        return startInfo;\n163:    }\n164:\n165:    private static string NewPidFile() => Path.Combine(Path.GetTempPath(), $\"bounded-process-{Guid.NewGuid():N}.pid\");\n166:\n167:    private static bool HasExited(string pidFile)\n168:    {\n169:        Assert.True(File.Exists(pidFile), \"The child never recorded its process id.\");\n170:        try\n171:        {\n172:            using var process = Process.GetProcessById(int.Parse(File.ReadAllText(pidFile).Trim(), System.Globalization.CultureInfo.InvariantCulture));\n173:            return process.HasExited;\n174:        }\n175:        catch (ArgumentException)\n176:        {\n177:            return true;\n178:        }\n179:    }\n180:\n181:    private static void KillRecorded(string pidFile)\n182:    {\n183:        if (!File.Exists(pidFile))\n184:        {\n185:            return;\n186:        }\n187:\n188:        try\n189:        {\n190:            using var process = Process.GetProcessById(int.Parse(File.ReadAllText(pidFile).Trim(), System.Globalization.CultureInfo.InvariantCulture));\n191:            process.Kill(entireProcessTree: true);\n192:        }\n193:        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or FormatException)\n194:        {\n195:        }\n196:        finally\n197:        {\n198:            File.Delete(pidFile);\n199:        }\n200:    }\n201:\n202:    private static bool IsBuildOutput(string relativePath)\n203:    {\n204:        var first = relativePath.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)[0];\n205:        return first is \"bin\" or \"obj\";\n206:    }\n207:\n208:    private static string FindRepositoryRoot()\n209:    {\n210:        var directory = new DirectoryInfo(AppContext.BaseDirectory);\n211:        while (directory is not null)\n212:        {\n213:            if (File.Exists(Path.Combine(directory.FullName, \"QBrainAi.sln\")))\n214:            {\n215:                return directory.FullName;\n216:            }\n217:\n218:            directory = directory.Parent;\n219:        }\n220:\n221:        throw new DirectoryNotFoundException(\"Could not find repository root containing QBrainAi.sln.\");\n222:    }\n223:}\n","exit_code":0,"status":"completed"}}
