{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/usr/bin/pwsh -Command \"pwsh.exe -NoProfile -NonInteractive -Command 'Get-Content tests/Build.Tests/TrimAnalysisWarningInventoryTests.cs | Select-Object -Skip 175 -First 60; Get-Content build/Build.InstallReplTool.cs | Select-Object -First 75; Get-Content tests/Build.Tests/BuildTargetTests.cs | Select-Object -Skip 445 -First 25; Get-Content src/QBrainAi.McpAgent/McpAgentOptions.cs | Select-Object -First 150'\"","aggregated_output":"    /// Best-effort artifact cleanup on every OS (TR-MCP-NUKE-010 AC-001, BUG-BUILD-009). On Windows a recursive\n    /// <see cref=\"Directory.Delete(string, bool)\"/> of a trimmed self-contained publish tree can block testhost for\n    /// tens of minutes under AV scan, so the delete runs in a detached cmd.exe there; elsewhere it runs in place.\n    /// </summary>\n    internal static void TryDeleteArtifacts(string artifactsRoot)\n    {\n        if (!Directory.Exists(artifactsRoot))\n        {\n            return;\n        }\n\n        if (!OperatingSystem.IsWindows())\n        {\n            try\n            {\n                Directory.Delete(artifactsRoot, recursive: true);\n            }\n            catch (IOException)\n            {\n            }\n            catch (UnauthorizedAccessException)\n            {\n            }\n\n            return;\n        }\n\n        try\n        {\n            var start = new ProcessStartInfo(\"cmd.exe\")\n            {\n                Arguments = $\"/c rmdir /s /q \\\"{artifactsRoot}\\\"\",\n                CreateNoWindow = true,\n                UseShellExecute = false,\n            };\n            Process.Start(start)?.Dispose();\n        }\n        catch (InvalidOperationException)\n        {\n        }\n        catch (System.ComponentModel.Win32Exception)\n        {\n        }\n    }\n\n    private static Dictionary<string, int> CountTrimWarnings(string output)\n    {\n        return TrimWarningPattern().Matches(output)\n            .Select(match => match.Groups[1].Value)\n            .GroupBy(code => code, StringComparer.Ordinal)\n            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.Ordinal);\n    }\n\n    private static string FindRepositoryRoot()\n    {\n        var directory = new DirectoryInfo(AppContext.BaseDirectory);\n        while (directory is not null)\n        {\n            if (File.Exists(Path.Combine(directory.FullName, \"QBrainAi.sln\")))\n            {\nusing Nuke.Common;\nusing Nuke.Common.Tooling;\nusing Serilog;\nusing System.IO;\nusing System.Security;\n\npartial class Build\n{\n    [Parameter(\"Update existing tool installation instead of fresh install\")]\n    readonly bool UpdateTool = false;\n\n    [Parameter(\"Uninstall the global tool\")]\n    readonly bool UninstallTool = false;\n\n    /// <summary>Install, update, or uninstall the qbrain-ai-repl global tool.</summary>\n    public Target InstallReplTool => _ => _\n        .DependsOn(PackReplTool)\n        .Executes(() =>\n        {\n            const string packageId = \"QBrainAI.Repl\";\n            var packageVersion = ResolveNuGetPackageVersion(PackageVersion, RootDirectory / \"GitVersion.yml\");\n\n            if (UninstallTool)\n            {\n                Log.Information(\"Uninstalling {Package}...\", packageId);\n                ProcessTasks.StartProcess(\"dotnet\", $\"tool uninstall --global {packageId}\");\n                return;\n            }\n\n            var packageSource = SecurityElement.Escape(LocalPackagesDirectory.ToString());\n            var nugetConfig = LocalPackagesDirectory / \"NuGet.LocalTool.config\";\n            File.WriteAllText(\n                nugetConfig,\n                $\"\"\"\n                <?xml version=\"1.0\" encoding=\"utf-8\"?>\n                <configuration>\n                  <packageSources>\n                    <clear />\n                    <add key=\"local-packages\" value=\"{packageSource}\" />\n                  </packageSources>\n                </configuration>\n                \"\"\");\n\n            var toolList = ProcessTasks.StartProcess(\"dotnet\", \"tool list --global\", logOutput: false, logInvocation: false);\n            toolList.WaitForExit();\n            toolList.AssertZeroExitCode();\n            var installedTools = string.Join('\\n', toolList.Output.Select(static output => output.Text));\n            var installedVersion = GetInstalledGlobalToolVersion(installedTools, packageId);\n            var shouldInstall = true;\n\n            if (!string.IsNullOrWhiteSpace(installedVersion))\n            {\n                if (UpdateTool || !string.Equals(installedVersion, packageVersion, StringComparison.OrdinalIgnoreCase))\n                {\n                    Log.Information(\n                        \"Uninstalling existing {Package} {InstalledVersion} before installing {PackageVersion}...\",\n                        packageId,\n                        installedVersion,\n                        packageVersion);\n                    ProcessTasks.StartProcess(\"dotnet\", $\"tool uninstall --global {packageId}\").AssertZeroExitCode();\n                }\n                else\n                {\n                    Log.Information(\"{Package} {Version} is already installed.\", packageId, installedVersion);\n                    shouldInstall = false;\n                }\n            }\n\n            if (shouldInstall)\n            {\n                Log.Information(\"Installing {Package} {Version}...\", packageId, packageVersion);\n                ProcessTasks.StartProcess(\n                        \"dotnet\",\n                        $\"tool install --global {packageId} --configfile \\\"{nugetConfig}\\\" --version {packageVersion}\")\n                    .AssertZeroExitCode();\n        Assert.Contains(\"tool uninstall --global {packageId}\", installReplTarget, StringComparison.Ordinal);\n        Assert.Contains(\"--version {packageVersion}\", installReplTarget, StringComparison.Ordinal);\n    }\n\n    [Fact]\n    public void InstallReplTool_ParsesInstalledGlobalToolVersion()\n    {\n        // TR-MCP-NUKE-007 AC-001 (BUG-BUILD-004): dotnet prints package ids in lowercase; QBrainAI.Repl (qbrain-ai-repl) and the\n        // 1.x alias SharpNinja.McpServer.Repl (mcpserver-repl, TR-MCP-QBRAIN-003) are different tools.\n        const string output = \"\"\"\n            Package Id                    Version      Commands\n            ---------------------------------------------------\n            qbrainai.repl                 6.1.1        qbrain-ai-repl\n            sharpninja.mcpserver.repl     1.4.41       mcpserver-repl\n            other.tool                    1.0.0        other\n            \"\"\";\n\n        var version = Build.GetInstalledGlobalToolVersion(output, \"QBrainAI.Repl\");\n\n        Assert.Equal(\"6.1.1\", version);\n        Assert.Equal(\"1.4.41\", Build.GetInstalledGlobalToolVersion(output, \"SharpNinja.McpServer.Repl\"));\n        Assert.Null(Build.GetInstalledGlobalToolVersion(output, \"missing.tool\"));\n    }\n\n    /// <summary>\nusing QBrainAi.Client;\nusing Microsoft.Agents.AI;\nusing Microsoft.Extensions.Configuration;\nusing Microsoft.Extensions.Logging;\n\nnamespace QBrainAi.McpAgent;\n\n/// <summary>\n/// FR-MCP-066/TR-MCP-AGENT-006: Configuration for the scaffolded MCP Agent host integration.\n/// </summary>\npublic sealed class McpAgentOptions\n{\n    /// <summary>\n    /// Configuration section name reserved for the MCP Agent integration.\n    /// </summary>\n    public const string SectionName = \"QBrainAi:McpAgent\";\n\n    /// <summary>1.x section used before the product root was QBrainAi.</summary>\n    public const string LegacyServerSectionName = \"McpServer:McpAgent\";\n\n    /// <summary>1.x section under the Mcp configuration root.</summary>\n    public const string LegacyProductSectionName = \"Mcp:McpAgent\";\n\n    /// <summary>\n    /// TR-MCP-QBRAIN-005: Selects the first present section in canonical, then McpServer, then Mcp order.\n    /// </summary>\n    /// <param name=\"configuration\">Application configuration.</param>\n    /// <returns>The section name to bind, or null when none of the aliases exist.</returns>\n    public static string? SelectSectionName(IConfiguration configuration)\n    {\n        ArgumentNullException.ThrowIfNull(configuration);\n        if (configuration.GetSection(SectionName).Exists())\n            return SectionName;\n        if (configuration.GetSection(LegacyServerSectionName).Exists())\n            return LegacyServerSectionName;\n        if (configuration.GetSection(LegacyProductSectionName).Exists())\n            return LegacyProductSectionName;\n        return null;\n    }\n\n    /// <summary>\n    /// Base URL for the target QBrain.AI workspace host.\n    /// </summary>\n    public Uri BaseUrl { get; set; } = new(\"http://localhost:7147\");\n\n    /// <summary>\n    /// Optional API key used to authenticate requests against the target workspace.\n    /// </summary>\n    public string? ApiKey { get; set; }\n\n    /// <summary>\n    /// Optional bearer token used to authenticate requests against the target workspace.\n    /// </summary>\n    public string? BearerToken { get; set; }\n\n    /// <summary>\n    /// Gets or sets a value indicating whether the hosted-agent registration should require an API key or bearer token.\n    /// </summary>\n    public bool RequireAuthentication { get; set; } = true;\n\n    /// <summary>\n    /// Optional workspace path header value used for multi-workspace routing.\n    /// </summary>\n    public string? WorkspacePath { get; set; }\n\n    /// <summary>\n    /// Optional privileged token used only for remote desktop-launch requests.\n    /// </summary>\n    public string? DesktopLaunchToken { get; set; }\n\n    /// <summary>\n    /// Stable identifier projected into <see cref=\"ChatClientAgentOptions.Id\"/> for host-side agent construction.\n    /// </summary>\n    public string AgentId { get; set; } = McpHostedAgentDefaults.DefaultAgentId;\n\n    /// <summary>\n    /// Friendly host-facing name for the scaffolded hosted agent.\n    /// </summary>\n    public string AgentName { get; set; } = McpHostedAgentDefaults.DefaultAgentName;\n\n    /// <summary>\n    /// Optional human-readable description projected into <see cref=\"ChatClientAgentOptions.Description\"/>.\n    /// </summary>\n    public string Description { get; set; } = McpHostedAgentDefaults.DefaultAgentDescription;\n\n    /// <summary>\n    /// Canonical source type reserved for later hosted-agent session-log workflow integration.\n    /// </summary>\n    public string SourceType { get; set; } = McpHostedAgentDefaults.DefaultSourceType;\n\n    /// <summary>\n    /// Selects the execution profile used when creating Microsoft Agent Framework run options.\n    /// </summary>\n    public McpAgentExecutionProfile ExecutionProfile { get; set; } = McpAgentExecutionProfile.Default;\n\n    /// <summary>\n    /// Gets or sets whether the hosted agent requires a session-log turn boundary before ACID work.\n    /// </summary>\n    public bool RequireSessionTurnBoundary { get; set; }\n\n    /// <summary>\n    /// Gets or sets whether the hosted agent requires durable audit/session-log coverage.\n    /// </summary>\n    public bool RequireDurableAudit { get; set; }\n\n    /// <summary>\n    /// Gets or sets whether mutating operations must be protected by transaction-capable server policy.\n    /// </summary>\n    public bool RequireTransactionalMutations { get; set; }\n\n    /// <summary>\n    /// Gets or sets whether model tool invocation must be serialized in the hosted function-invocation pipeline.\n    /// </summary>\n    public bool RequireSerializedToolInvocation { get; set; }\n\n    /// <summary>\n    /// Gets or sets whether caller-supplied host tools may be merged into ACID run options.\n    /// Defaults to <see langword=\"false\"/> so the ACID profile exposes only approved MCP tools.\n    /// </summary>\n    public bool AllowHostToolsInAcidProfile { get; set; }\n\n    /// <summary>\n    /// TR-MCP-QBTOOLS-004: Gets or sets whether the QBAgent <c>git</c> tool may run the <c>push</c> subcommand.\n    /// Defaults to <see langword=\"false\"/> so an autonomous agent cannot move remote state until a host opts in;\n    /// when enabled, push is still constrained to the existing <c>origin</c> remote.\n    /// </summary>\n    public bool AllowGitPush { get; set; }\n\n    /// <summary>\n    /// HTTP timeout applied to the transport client created for the hosted agent scaffold.\n    /// </summary>\n    public TimeSpan Timeout { get; set; } = TimeSpan.FromSeconds(300);\n\n    /// <summary>\n    /// Applies the stable ACID tightly coupled Agent Framework profile to this options instance.\n    /// </summary>\n    /// <returns>The current options instance for fluent host configuration.</returns>\n    public McpAgentOptions UseAcidTightlyCoupledProfile()\n    {\n        var definition = QBAgentDefinition.Instance;\n\n        ExecutionProfile = McpAgentExecutionProfile.AcidTightlyCoupled;\n        AgentId = definition.AgentId;\n        AgentName = definition.AgentName;\n        Description = definition.Description;\n        SourceType = definition.SourceType;\n        RequireAuthentication = true;\n        RequireSessionTurnBoundary = true;\n        RequireDurableAudit = true;\n        RequireTransactionalMutations = true;\n","exit_code":0,"status":"completed"}}
