    63 [id=63,shape=rect, label=<<font point-size="34">A project working<br />database</font><br /><font point-size="19">[Container: Native Windows Dolt / loopback 3306]</font><br /><br /><font point-size="24">Independent drafts and<br />versioned project history</font>>, style=filled, color="#39747c", fillcolor="#eef5f7", fontcolor="#173647"]
    65 [id=65,shape=rect, label=<<font point-size="34">A operational store</font><br /><font point-size="19">[Container: SQLite or supported provider]</font><br /><br /><font point-size="24">Local audit, leases, IDs,<br />aliases and durable outboxes</font>>, style=filled, color="#39747c", fillcolor="#eef5f7", fontcolor="#173647"]
