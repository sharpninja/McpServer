{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/McpServer.Support.Mcp/McpServer.Support.Mcp.csproj"],
          "src": "."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net9.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["docs/**.md", "docs/**/toc.yml", "*.md", "toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["docs/images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "MCP Server",
      "_appName": "MCP Server Documentation",
      "_appFooter": "MCP Server &copy; 2025",
      "_enableSearch": true
    }
  }
}
