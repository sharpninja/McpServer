<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NukeBuild.Tests</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
    <!-- Exclude v2 xunit packages pulled transitively (e.g. via SkippableFact) to prevent CS0433 duplicate with v3 -->
    <PackageReference Include="Xunit.SkippableFact" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
    <PackageReference Include="xunit.extensibility.core" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
    <PackageReference Include="xunit.extensibility.execution" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\build\_build.csproj" />
    <EmbeddedResource Include="Fixtures\valid-instances.yaml"
                      LogicalName="Build.Tests.Fixtures.valid-instances.yaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\README.md" LogicalName="Repository.README.md" />
    <EmbeddedResource Include="..\..\docs\AGENT-PLUGIN-AVAILABILITY.md" LogicalName="Repository.docs.AGENT-PLUGIN-AVAILABILITY.md" />
    <EmbeddedResource Include="..\..\docs\REPL-AGENT-GUIDE.md" LogicalName="Repository.docs.REPL-AGENT-GUIDE.md" />
    <EmbeddedResource Include="..\..\templates\prompt-templates.yaml" LogicalName="Repository.templates.prompt-templates.yaml" />
    <EmbeddedResource Include="..\..\azure-pipelines.yml" LogicalName="Repository.azure-pipelines.yml" />
    <EmbeddedResource Include="..\..\.github\workflows\build.yml" LogicalName="Repository.github.workflows.build.yml" />
    <EmbeddedResource Include="..\..\docs\context\scratch-workspace-integration-tests.md" LogicalName="Repository.docs.context.scratch-workspace-integration-tests.md" />
    <EmbeddedResource Include="..\..\docs\Project\wiki\azure\*">
      <LogicalName>Repository.wiki.azure.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\Project\wiki\github\*">
      <LogicalName>Repository.wiki.github.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
