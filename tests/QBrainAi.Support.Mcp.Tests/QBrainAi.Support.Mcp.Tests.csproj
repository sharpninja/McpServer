<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <Import Project="..\..\lib\NSubstitute\NSubstitute.Reference.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <McpRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</McpRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QBrainAi.TransactionSecurity\QBrainAi.TransactionSecurity.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Support.Mcp\QBrainAi.Support.Mcp.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Cqrs.Mvvm\QBrainAi.Cqrs.Mvvm.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.SessionLog.Transcripts\QBrainAi.SessionLog.Transcripts.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Client\QBrainAi.Client.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Repl.Core\QBrainAi.Repl.Core.csproj" />
    <ProjectReference Include="..\QBrainAi.ProcessTree.TestHelper\QBrainAi.ProcessTree.TestHelper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TestRepositoryRoot.cs" Link="Shared\TestRepositoryRoot.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyMetadata Include="McpRepositoryRoot" Value="$(McpRepositoryRoot)" />
    <None Update="Fixtures\AgentHelp\**\*"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Transcripts\**\*"
          CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Fixtures\TransactionGatedStdioRouting\route.md"
                      LogicalName="TransactionGatedStdioRouting.route.md" />
    <EmbeddedResource Include="..\..\templates\prompt-templates.yaml"
                      LogicalName="TriagePromptTemplate.prompt-templates.yaml" />
  </ItemGroup>
  <!-- 2026-11-07, TEST-MCP-USECASE-018; TEST-MCP-USECASE-020; TR-MCP-NUKE-019 AC-7: the OS-conditional compile block that
       governed the seven platform-native files moved whole to QBrainAi.Support.Mcp.EnvironmentIntegrationTests with those
       files and the harnesses that count them (slice S8, hostile validation finding R14-F4); their copies here are empty. -->
</Project>
