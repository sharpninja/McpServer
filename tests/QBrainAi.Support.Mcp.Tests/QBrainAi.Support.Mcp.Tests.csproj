<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <Import Project="..\..\lib\NSubstitute\NSubstitute.Reference.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <McpRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</McpRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QBrainAi.TransactionSecurity\QBrainAi.TransactionSecurity.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Support.Mcp\QBrainAi.Support.Mcp.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Cqrs.Mvvm\QBrainAi.Cqrs.Mvvm.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.SessionLog.Transcripts\QBrainAi.SessionLog.Transcripts.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Client\QBrainAi.Client.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Repl.Core\QBrainAi.Repl.Core.csproj" />
    <ProjectReference Include="..\QBrainAi.ProcessTree.TestHelper\QBrainAi.ProcessTree.TestHelper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyMetadata Include="McpRepositoryRoot" Value="$(McpRepositoryRoot)" />
    <None Update="Fixtures\AgentHelp\**\*"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Transcripts\**\*"
          CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Fixtures\TransactionGatedStdioRouting\route.md"
                      LogicalName="TransactionGatedStdioRouting.route.md" />
    <EmbeddedResource Include="..\..\templates\prompt-templates.yaml"
                      LogicalName="TriagePromptTemplate.prompt-templates.yaml" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Storage\BugTriage139FifteenthLinuxNativeTests.cs" />
    <Compile Remove="Storage\BugTriage139SixteenthLinuxTests.cs" />
    <Compile Remove="Storage\BugTriage139EighteenthLinuxTests.cs" />
    <Compile Remove="Services\RequirementsFourteenthLinuxNativeTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="Storage\BugTriage139FifteenthWindowsNativeTests.cs" />
    <Compile Remove="Storage\BugTriage139SixteenthIdentityWindowsTests.cs" />
    <Compile Remove="Documentation\BugTriage139SixteenthWindowsProcessTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) And !$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="Storage\BugTriage139FifteenthWindowsNativeTests.cs" />
    <Compile Remove="Storage\BugTriage139FifteenthLinuxNativeTests.cs" />
    <Compile Remove="Storage\BugTriage139SixteenthIdentityWindowsTests.cs" />
    <Compile Remove="Storage\BugTriage139SixteenthLinuxTests.cs" />
    <Compile Remove="Storage\BugTriage139EighteenthLinuxTests.cs" />
    <Compile Remove="Services\RequirementsFourteenthLinuxNativeTests.cs" />
    <Compile Remove="Documentation\BugTriage139SixteenthWindowsProcessTests.cs" />
  </ItemGroup>
</Project>
