<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <Import Project="..\..\lib\NSubstitute\NSubstitute.Reference.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <McpRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</McpRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\McpServer.TransactionSecurity\McpServer.TransactionSecurity.csproj" />
    <ProjectReference Include="..\..\src\McpServer.Support.Mcp\McpServer.Support.Mcp.csproj" />
    <ProjectReference Include="..\..\src\McpServer.Cqrs.Mvvm\McpServer.Cqrs.Mvvm.csproj" />
    <ProjectReference Include="..\..\src\McpServer.SessionLog.Transcripts\McpServer.SessionLog.Transcripts.csproj" />
    <ProjectReference Include="..\..\src\McpServer.Client\McpServer.Client.csproj" />
    <ProjectReference Include="..\McpServer.ProcessTree.TestHelper\McpServer.ProcessTree.TestHelper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyMetadata Include="McpRepositoryRoot" Value="$(McpRepositoryRoot)" />
  </ItemGroup>
</Project>
