<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: the integration-owned project of QBAgent's
       Category=Integration cases, split out of QBrainAi.QBAgent.Tests so a unit-owned project holds only unit cases
       (slice S3, hostile validation finding R14-F4). Same packages and references as QBrainAi.QBAgent.Tests, with the
       shared repository-root locator its skill cases read the checkout through; QBrainAi.QBAgent grants it internals
       for the heartbeat overlay its run-loop case asserts on. -->
  <PropertyGroup>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QBrainAi.QBAgent\QBrainAi.QBAgent.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.QBAgent.Tools\QBrainAi.QBAgent.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TestRepositoryRoot.cs" Link="Shared\TestRepositoryRoot.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
