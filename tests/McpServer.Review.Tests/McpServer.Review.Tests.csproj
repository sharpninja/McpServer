<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>McpServer.Review.Tests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="SharpNinja.aiUnit" />
    <!-- Exclude v2 xunit packages pulled transitively to prevent CS0433 duplicate with v3 (following pattern in PlanReview.Tests and other v3 suites) -->
    <PackageReference Include="xunit.extensibility.core" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
    <PackageReference Include="xunit.extensibility.execution" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.aiunit.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="aiunit-grok-single.cmd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="aiunit-grok-json.cmd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="aiunit-grok-json.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="aiunit-claude-print.cmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
