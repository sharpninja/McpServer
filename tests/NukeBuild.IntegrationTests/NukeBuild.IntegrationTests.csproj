<Project Sdk="Microsoft.NET.Sdk">

  <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: the integration-owned project of the build's
       Category=Integration cases, split out of the infrastructure-owned Build.Tests (slice S4, hostile validation finding
       R14-F4; operator 2026-11-06: "Move them (Recommended)"). Like Build.Tests it references the running build project,
       so Compile and Restore leave it out (Build.GetBuildProjectFiles) and the targets that run it build it. The shared
       support it needs is linked from Build.Tests, not copied; it needs no embedded resources. -->
  <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: the project, formerly Build.IntegrationTests, now carries the
       same name as its root namespace, NukeBuild.IntegrationTests (operator 2026-11-07: "Project names and root
       namespaces for the project should match, so fix the project name."); a namespace Build.* would collide with the
       build's global Build class, so the name follows the namespace. Compile and Restore still leave it out. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NukeBuild.IntegrationTests</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- Exclude v2 xunit packages pulled transitively (e.g. via SkippableFact) to prevent CS0433 duplicate with v3 -->
    <PackageReference Include="Xunit.SkippableFact" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
    <PackageReference Include="xunit.extensibility.core" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
    <PackageReference Include="xunit.extensibility.execution" PrivateAssets="all" ExcludeAssets="compile;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\build\_build.csproj" />
  </ItemGroup>

  <!-- Shared by link with Build.Tests (one definition each): the global usings (Xunit and its Assert alias), the bounded
       child-process runner, the official plugin-core sync check, the lane composition contract, and the parts extracted
       from split classes in slice S4. -->
  <ItemGroup>
    <Compile Include="..\Build.Tests\GlobalUsings.cs" Link="Shared\GlobalUsings.cs" />
    <Compile Include="..\Build.Tests\BoundedProcess.cs" Link="Shared\BoundedProcess.cs" />
    <Compile Include="..\Build.Tests\OfficialPluginCoreSyncTestSupport.cs" Link="Shared\OfficialPluginCoreSyncTestSupport.cs" />
    <Compile Include="..\Build.Tests\IntegrationLaneProjectsContract.cs" Link="Shared\IntegrationLaneProjectsContract.cs" />
    <Compile Include="..\Build.Tests\GeneratedObsoletePragmaText.cs" Link="Shared\GeneratedObsoletePragmaText.cs" />
    <Compile Include="..\Build.Tests\ServiceUpdateTestSupport.cs" Link="Shared\ServiceUpdateTestSupport.cs" />
    <Compile Include="..\Build.Tests\TrimArtifactCleanup.cs" Link="Shared\TrimArtifactCleanup.cs" />
  </ItemGroup>
</Project>
