<Project>
  <Import Project="..\Directory.Build.targets" Condition="Exists('..\Directory.Build.targets')" />

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Validation'))">
    <Compile Include="$(MSBuildThisFileDirectory)Validation.Shared\ValidationAuth.cs"
             Link="Validation.Shared\ValidationAuth.cs" />
  </ItemGroup>

  <!-- TR-MCP-QBOLLAMA-002: shared Ollama server lifecycle policy, linked into the unit project that
       tests it and the integration project whose fixture consumes it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'QBrainAi.Support.Mcp.Tests' Or '$(MSBuildProjectName)' == 'QBrainAi.Support.Mcp.IntegrationTests'">
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport.Shared\OllamaServerController.cs"
             Link="TestSupport.Shared\OllamaServerController.cs" />
  </ItemGroup>

  <!-- TR-MCP-NUKE-019 AC-6 and AC-7: the temporary-instance checks, linked into the unit project that proves their
       contract, the integration project whose cases call them, and every project that links ScratchQBrainAi, whose
       start uses the restart check. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'QBrainAi.Repl.Core.Tests' Or '$(MSBuildProjectName)' == 'QBrainAi.Repl.IntegrationTests' Or '$(MSBuildProjectName)' == 'QBrainAi.Support.Mcp.IntegrationTests'">
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport.Shared\TemporaryInstanceChecks.cs"
             Link="TestSupport.Shared\TemporaryInstanceChecks.cs" />
  </ItemGroup>

  <!-- TR-MCP-NUKE-019 AC-6: the one temporary QBrain.AI instance (a Support.Mcp process on a free port in a test-owned
       root, with its own marker and database), linked into the integration projects that start REPL children against
       it, with the repository-root locator and the scratch SQLite schema it uses. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'QBrainAi.Repl.IntegrationTests' Or '$(MSBuildProjectName)' == 'QBrainAi.Support.Mcp.IntegrationTests'">
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport.Shared\ScratchQBrainAi.cs"
             Link="TestSupport.Shared\ScratchQBrainAi.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\TestRepositoryRoot.cs"
             Link="Shared\TestRepositoryRoot.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'QBrainAi.Repl.IntegrationTests'">
    <Compile Include="$(MSBuildThisFileDirectory)QBrainAi.Support.Mcp.IntegrationTests\ScratchSqliteSchema.cs"
             Link="TestSupport.Shared\ScratchSqliteSchema.cs" />
  </ItemGroup>
</Project>
