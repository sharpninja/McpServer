<Project>
  <Import Project="..\Directory.Build.targets" Condition="Exists('..\Directory.Build.targets')" />

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Validation'))">
    <Compile Include="$(MSBuildThisFileDirectory)Validation.Shared\ValidationAuth.cs"
             Link="Validation.Shared\ValidationAuth.cs" />
  </ItemGroup>

  <!-- TR-MCP-QBOLLAMA-002: shared Ollama server lifecycle policy, linked into the unit project that
       tests it and the integration project whose fixture consumes it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'McpServer.Support.Mcp.Tests' Or '$(MSBuildProjectName)' == 'McpServer.Support.Mcp.IntegrationTests'">
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport.Shared\OllamaServerController.cs"
             Link="TestSupport.Shared\OllamaServerController.cs" />
  </ItemGroup>
</Project>
