<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>QBrainAi.PluginIntegration.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="SharpNinja.aiUnit" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QBrainAi.Client\QBrainAi.Client.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Support.Mcp\QBrainAi.Support.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="scenarios\plugin-sessionlog-scenarios.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- TEST-MCP-PLUGININT-001 AC-004 (PLAN-SESSIONTRIAGEFIX-001 E6): each operating system gets the strategy whose command it can start. -->
    <None Include="appsettings.aiunit.json" CopyToOutputDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <None Include="appsettings.aiunit.unix.json" Link="appsettings.aiunit.json" CopyToOutputDirectory="PreserveNewest" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <None Include="..\..\templates\prompt-templates.yaml" Link="templates\prompt-templates.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="invoke-node-plugin-export.mjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="aiunit-grok-evaluator.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="aiunit-grok-evaluator.cmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
