<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <Import Project="..\..\lib\NSubstitute\NSubstitute.Reference.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="YamlDotNet" />
    <!-- TR-MCP-NUKE-019 AC-6: the shared temporary instance stages its SQLite database through EF Core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QBrainAi.Repl.Core\QBrainAi.Repl.Core.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Repl.Host\QBrainAi.Repl.Host.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Client\QBrainAi.Client.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.TransactionSecurity\QBrainAi.TransactionSecurity.csproj" />
    <!-- TR-MCP-NUKE-019 AC-6: the temporary instance runs QBrainAi.Support.Mcp with the SQLite migrations. -->
    <ProjectReference Include="..\..\src\QBrainAi.Support.Mcp\QBrainAi.Support.Mcp.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Storage.SqliteMigrations\QBrainAi.Storage.SqliteMigrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
