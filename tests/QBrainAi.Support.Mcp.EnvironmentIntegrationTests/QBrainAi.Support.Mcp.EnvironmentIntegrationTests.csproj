<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: the integration-owned project of QBrainAi.Support.Mcp.Tests'
       Category=Integration cases, split out folder by folder so the unit-owned project holds only unit cases (slice S5,
       hostile validation finding R14-F4; operator 2026-11-06: "...Environment.IntegrationTests (Recommended)"). It
       mirrors QBrainAi.Support.Mcp.Tests with only the references the moved cases use: the repository-root assembly
       metadata (TR-MCP-USECASE-018 AC-005), and no copied fixtures, embedded resources or OS-conditional compile block
       until moved cases need them. The lane runs it whole with its Category=Integration and host platform filter. -->
  <PropertyGroup>
    <Configurations>Debug;Release;Staging</Configurations>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: slice S6 moved FileGitHubWorkspaceTokenStoreTests and
       RepoFileServiceTests, which substitute services with NSubstitute, so this project references the vendored
       NSubstitute the same way QBrainAi.Support.Mcp.Tests does. -->
  <Import Project="..\..\lib\NSubstitute\NSubstitute.Reference.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: the root namespace joins "Environment" and "IntegrationTests"
         into one segment. A namespace QBrainAi.Support.Mcp.Environment would shadow System.Environment for every bare
         Environment. inside a QBrainAi.Support.Mcp.* namespace of this assembly (C# looks up enclosing namespaces before
         global usings), which 31 Support.Mcp.Tests files that move here use; the assembly keeps the project name. -->
    <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: the project, formerly QBrainAi.Support.Mcp.Environment.IntegrationTests,
         now carries the same name as its root namespace, QBrainAi.Support.Mcp.EnvironmentIntegrationTests (operator
         2026-11-07: "Project names and root namespaces for the project should match, so fix the project name."), so its
         assembly, which still takes the project name, has that name too; the comment above still gives the reason for the
         joined segment. -->
    <RootNamespace>QBrainAi.Support.Mcp.EnvironmentIntegrationTests</RootNamespace>
    <McpRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</McpRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2026-11-07, TR-MCP-USECASE-018 AC-006; TR-MCP-NUKE-019 AC-7: the linked UnitSuitePlatformScanner parses C# with
         Roslyn for UnitSuitePlatformScannerTests (slice S6). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QBrainAi.Support.Mcp\QBrainAi.Support.Mcp.csproj" />
    <ProjectReference Include="..\..\src\QBrainAi.Client\QBrainAi.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The linked support below keeps its QBrainAi.Support.Mcp.Tests namespaces, so a moved file changes only its own
         namespace line. -->
    <Using Include="QBrainAi.Support.Mcp.Tests.Storage" />
    <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: the namespaces of the support linked for slice S6, which the
         moved files reached as their enclosing namespace before. -->
    <Using Include="QBrainAi.Support.Mcp.Tests.Configuration" />
    <Using Include="QBrainAi.Support.Mcp.Tests.Infrastructure" />
    <Using Include="QBrainAi.Support.Mcp.Tests.Memory" />
    <Using Include="QBrainAi.Support.Mcp.Tests.TestSupport" />
    <AssemblyMetadata Include="McpRepositoryRoot" Value="$(McpRepositoryRoot)" />
  </ItemGroup>
  <!-- Shared by link with QBrainAi.Support.Mcp.Tests (one definition each, never copied): xUnit collection definitions and
       assembly fixtures apply per assembly, so the four serialized collections (FR-MCP-TESTRESOURCE-001 ac-7 and ac-9)
       and the hermetic user-profile assembly fixture (TR-MCP-WS-005) are compiled into both. -->
  <ItemGroup>
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\HermeticUserProfileFixture.cs" Link="Shared\HermeticUserProfileFixture.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\TestSupport\ProcessEnvironmentCollection.cs" Link="Shared\TestSupport\ProcessEnvironmentCollection.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Storage\WorkspaceIdentityNativeProcessStateCollection.cs" Link="Shared\Storage\WorkspaceIdentityNativeProcessStateCollection.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Storage\SqlServerLocalDbCollection.cs" Link="Shared\Storage\SqlServerLocalDbCollection.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Documentation\RepositoryRootProcessStateCollection.cs" Link="Shared\Documentation\RepositoryRootProcessStateCollection.cs" />
  </ItemGroup>
  <!-- 2026-11-07, FR-MCP-BUILD-001; TR-MCP-NUKE-019 AC-7: support that the cases moved in slice S6 share with unit cases
       that stay in QBrainAi.Support.Mcp.Tests, linked (one definition each, never copied); the repository-root locator
       is the shared tests/Shared one (TR-MCP-USECASE-018 AC-005). -->
  <ItemGroup>
    <Compile Include="..\Shared\TestRepositoryRoot.cs" Link="Shared\TestRepositoryRoot.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Configuration\UnitSuitePlatformScanner.cs" Link="Shared\Configuration\UnitSuitePlatformScanner.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Infrastructure\RepositoryEvidenceTestSupport.cs" Link="Shared\Infrastructure\RepositoryEvidenceTestSupport.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Infrastructure\RepositoryEvidenceWindowsProcess.cs" Link="Shared\Infrastructure\RepositoryEvidenceWindowsProcess.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Memory\MemoryBenchCatalog.cs" Link="Shared\Memory\MemoryBenchCatalog.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Memory\MemoryS1Harness.CoreA1.cs" Link="Shared\Memory\MemoryS1Harness.CoreA1.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Memory\MemoryS1Harness.CoreA2.cs" Link="Shared\Memory\MemoryS1Harness.CoreA2.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Memory\MemoryS1Harness.CoreB.cs" Link="Shared\Memory\MemoryS1Harness.CoreB.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Memory\MemoryS1Harness.S4.cs" Link="Shared\Memory\MemoryS1Harness.S4.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Memory\MemoryS5Catalog.cs" Link="Shared\Memory\MemoryS5Catalog.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\Storage\EphemeralPostgresFixture.cs" Link="Shared\Storage\EphemeralPostgresFixture.cs" />
    <Compile Include="..\QBrainAi.Support.Mcp.Tests\TestSupport\WindowsJunction.cs" Link="Shared\TestSupport\WindowsJunction.cs" />
  </ItemGroup>
  <!-- 2026-11-07, TEST-MCP-TRANSCRIPT-008; TR-MCP-NUKE-019 AC-7: the real Codex transcript that TranscriptMcpStdioHostTests
       copies from its output folder, linked from QBrainAi.Support.Mcp.Tests (slice S6). -->
  <ItemGroup>
    <None Include="..\QBrainAi.Support.Mcp.Tests\Fixtures\Transcripts\real\codex\session.jsonl" Link="Fixtures\Transcripts\real\codex\session.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
