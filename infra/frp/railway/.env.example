# FRP server (frps) runtime settings for local Docker or Railway service variables.

# Required shared secret (set a strong random value in Railway service variables)
FRP_TOKEN=replace-with-strong-token

# FRPS control port (frpc connects here)
FRPS_BIND_PORT=7000

# FRPS HTTP vhost port (public HTTP traffic terminates here)
FRPS_VHOST_HTTP_PORT=8080

# Optional wildcard subdomain host for FRP HTTP subdomains (requires DNS)
# FRPS_SUBDOMAIN_HOST=example.com

# Log level: trace, debug, info, warn, error
FRPS_LOG_LEVEL=info
